<%- contentFor('body') %>

<style>
  .payment-loss-kpi { border-radius: .85rem; }
  .payment-loss-stage { position: relative; overflow: hidden; }
  .payment-loss-stage::after { content: ''; position: absolute; left: 0; bottom: 0; height: 4px; width: var(--stage-width, 0%); background: var(--bs-primary); }
  .payment-loss-count { font-size: clamp(1.55rem, 2.4vw, 2.35rem); line-height: 1; }
  .payment-loss-click { cursor: pointer; text-decoration: none; }
  .payment-loss-click:hover { text-decoration: underline; }
  .payment-loss-table th { white-space: nowrap; }
  .payment-loss-note { border-left: 4px solid var(--bs-info); }
  [data-bs-theme="dark"] .payment-loss-note { background: rgba(13,202,240,.08) !important; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Сквозная аналитика</h1>
    <p class="text-muted mb-0">Показатели воронки, выручки и лимитов (Временная зона: Europe/Moscow)</p>
    <% if (typeof lastAggregation !== 'undefined' && lastAggregation && lastAggregation.lastUpdate) { %>
      <div class="text-muted small mt-1">
        <span class="me-3">
          <i class="bi bi-clock-history me-1 text-primary"></i>Последнее обновление данных: <strong><%= lastAggregation.lastUpdate %></strong>
        </span>
        <span>
          <i class="bi bi-calendar-check me-1 text-primary"></i>Агрегированный период в базе: <strong><%= lastAggregation.minDay %> — <%= lastAggregation.maxDay %></strong>
        </span>
      </div>
    <% } %>
  </div>
  
  <div class="d-flex gap-2 align-items-end flex-wrap">
    <form class="d-flex gap-2 align-items-end" method="get" action="/admin/analytics">
      <div>
        <label class="form-label small text-muted mb-1">С даты</label>
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= startDate %>">
      </div>
      <div>
        <label class="form-label small text-muted mb-1">По дату</label>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= endDate %>">
      </div>
      <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Показать</button>
    </form>
    
    <a href="/admin/analytics/export?startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn btn-sm btn-success text-white">
      <i class="bi bi-file-earmark-excel me-1"></i>Экспорт XLSX
    </a>

    <button type="button" class="btn btn-sm btn-outline-success" id="system-self-test-button" onclick="runSystemSelfTest()">
      <i class="bi bi-activity me-1"></i>Self-test
    </button>
    
    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#aggregation-panel" title="Агрегация данных">
      <i class="bi bi-gear me-1"></i>Агрегация
    </button>
  </div>
</div>

<div id="system-self-test-result" class="alert d-none mb-3" role="status"></div>

<div class="collapse mb-3" id="aggregation-panel">
  <div class="card card-body bg-light border-0 shadow-sm">
    <div class="row g-3">
      
      <!-- Блок 1: Агрегация одного дня -->
      <div class="col-md-4 border-end">
        <h6 class="fw-semibold text-warning mb-2"><i class="bi bi-calendar-day me-1"></i>Агрегация одного дня</h6>
        <p class="text-muted small mb-2">Пересчитать конкретные сутки при пропусках данных.</p>
        <form id="agg-day-form" class="d-flex gap-2 align-items-end">
          <div class="flex-grow-1">
            <input type="date" id="agg-day-date" class="form-control form-control-sm" required>
          </div>
          <button type="submit" class="btn btn-sm btn-warning" id="agg-day-btn">
            <i class="bi bi-play-fill"></i> Запустить
          </button>
        </form>
      </div>

      <!-- Блок 2: Агрегация за период -->
      <div class="col-md-5 border-end">
        <h6 class="fw-semibold text-primary mb-2"><i class="bi bi-calendar-range me-1"></i>Пересчитать период</h6>
        <p class="text-muted small mb-2">Агрегирует данные последовательно за диапазон дней.</p>
        <form id="agg-period-form" class="d-flex gap-2 align-items-end">
          <div>
            <label class="form-label small text-muted mb-1">С даты</label>
            <input type="date" id="agg-period-start" class="form-control form-control-sm" required>
          </div>
          <div>
            <label class="form-label small text-muted mb-1">По дату</label>
            <input type="date" id="agg-period-end" class="form-control form-control-sm" required>
          </div>
          <button type="submit" class="btn btn-sm btn-primary" id="agg-period-btn">
            <i class="bi bi-play-fill"></i> Запустить
          </button>
        </form>
      </div>

      <!-- Блок 3: Восстановление пропусков -->
      <div class="col-md-3">
        <h6 class="fw-semibold text-success mb-2"><i class="bi bi-tools me-1"></i>Инструменты</h6>
        <p class="text-muted small mb-2">Заполнить дыры за последние 7 дней.</p>
        <button type="button" id="btn-backfill" class="btn btn-sm btn-success w-100">
          <i class="bi bi-arrow-repeat"></i> Восстановить пропущенные
        </button>
      </div>

    </div>

    <!-- Информатор прогресса -->
    <div id="agg-progress-container" class="mt-3 p-3 bg-white rounded border d-none">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="fw-semibold text-primary" id="agg-progress-title">Выполняется агрегация...</span>
        <span class="badge bg-primary" id="agg-progress-pct">0%</span>
      </div>
      <div class="progress mb-2" style="height: 12px;">
        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="agg-progress-bar" role="progressbar" style="width: 0%;"></div>
      </div>
      <div class="d-flex justify-content-between small text-muted">
        <span id="agg-progress-status">Выполнено: 0 / 0 дней</span>
        <span id="agg-progress-current">Текущий день: —</span>
      </div>
    </div>

    <div id="agg-general-status" class="mt-2 small"></div>
  </div>
</div>

<!-- AI Growth Assistant Recommendations Alert Box -->
<% if (typeof growthData !== 'undefined' && growthData && growthData.recommendations && growthData.recommendations.length > 0) { %>
  <div class="card shadow-sm border-0 border-start border-4 border-warning mb-4 bg-light">
    <div class="card-body py-3">
      <div class="d-flex align-items-center mb-2">
        <i class="bi bi-cpu text-warning fs-4 me-2"></i>
        <h5 class="card-title h6 fw-bold mb-0 text-gray-800">Growth Assistant (Аналитические рекомендации)</h5>
      </div>
      <div class="d-flex flex-column gap-2 small">
        <% growthData.recommendations.forEach(rec => { %>
          <div class="p-2 bg-white rounded border-start border-3 <%= rec.type === 'warning' ? 'border-danger' : (rec.type === 'success' ? 'border-success' : 'border-info') %>">
            <div class="fw-semibold text-gray-800 mb-1">
              <% if (rec.type === 'warning') { %>
                <span class="text-danger">⚠️ <%= rec.title %></span>
              <% } else if (rec.type === 'success') { %>
                <span class="text-success">✅ <%= rec.title %></span>
              <% } else { %>
                <span class="text-info">💡 <%= rec.title %></span>
              <% } %>
            </div>
            <div class="text-muted"><%= rec.text %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<!-- Вкладки управления (Tabs) -->
<ul class="nav nav-pills mb-4 gap-2 bg-light p-2 rounded shadow-sm border" id="analyticsTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active py-2 px-3 fw-bold" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-pane" type="button" role="tab" aria-controls="dashboard-pane" aria-selected="true">
      <i class="bi bi-speedometer2 me-1"></i> Активность
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link py-2 px-3 fw-bold" id="compare-tab" data-bs-toggle="tab" data-bs-target="#compare-pane" type="button" role="tab" aria-controls="compare-pane" aria-selected="false">
      <i class="bi bi-arrow-left-right me-1"></i> Сравнение периодов
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link py-2 px-3 fw-bold" id="cohorts-tab" data-bs-toggle="tab" data-bs-target="#cohorts-pane" type="button" role="tab" aria-controls="cohorts-pane" aria-selected="false">
      <i class="bi bi-grid-3x3-gap me-1"></i> Когортный анализ
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link py-2 px-3 fw-bold" id="revenue-tab" data-bs-toggle="tab" data-bs-target="#revenue-pane" type="button" role="tab" aria-controls="revenue-pane" aria-selected="false">
      <i class="bi bi-cash-coin me-1"></i> Мониторинг денег
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link py-2 px-3 fw-bold" id="payment-loss-tab" data-bs-toggle="tab" data-bs-target="#payment-loss-pane" type="button" role="tab" aria-controls="payment-loss-pane" aria-selected="false">
      <i class="bi bi-funnel me-1"></i> Почему не купили
    </button>
  </li>
</ul>

<div class="tab-content" id="analyticsTabsContent">
  <!-- Вкладка 1: Дашборд активности -->
  <div class="tab-pane fade show active" id="dashboard-pane" role="tabpanel" aria-labelledby="dashboard-tab">
    
    <%# Summary Cards %>
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
          <div class="card-body">
            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Средний DAU</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= avgDau %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
          <div class="card-body">
            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Выручка RUB (СБП/Т-Банк)</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= (totalRevRub / 100).toFixed(2) %> ₽</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
          <div class="card-body">
            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Выручка XTR (Stars)</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800">⭐️ <%= totalRevXtr %> Stars</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
          <div class="card-body">
            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Всего скачиваний</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalDownloads %></div>
          </div>
        </div>
      </div>
    </div>

    <%# Charts Section %>
    <div class="row g-4 mb-4">
      <div class="col-lg-8">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-white fw-bold"><i class="bi bi-activity me-2 text-primary"></i>Динамика активности (DAU / WAU / MAU)</div>
          <div class="card-body">
            <canvas id="activeUsersChart" height="280"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-white fw-bold"><i class="bi bi-funnel-fill me-2 text-warning"></i>Воронка продаж тарифов</div>
          <div class="card-body">
            <canvas id="funnelChart" height="280"></canvas>
          </div>
        </div>
      </div>
    </div>

    <%# Cohort Limit Analysis %>
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-bold text-primary"><i class="bi bi-bar-chart-steps me-2"></i>Глубокий анализ лимита Free</div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-md-6 border-end">
            <h5 class="card-title h6 fw-semibold mb-3">Распределение скачиваний пользователей (за период)</h5>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Кол-во треков в день</th>
                    <th class="text-end">Пользователей</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (limitDistribution.length === 0) { %>
                    <tr><td colspan="2" class="text-center text-muted">Нет данных</td></tr>
                  <% } else { %>
                    <% limitDistribution.forEach(row => { %>
                      <tr>
                        <td><%= row.downloads_count %> трек(ов)</td>
                        <td class="text-end fw-bold text-primary"><%= row.users_count %></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
          
          <div class="col-md-6">
            <h5 class="card-title h6 fw-semibold mb-3">Конверсия и отток после лимита (за период)</h5>
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>Достигли лимита (Free / Plus / Pro):</span>
                <span class="badge bg-danger rounded-pill"><%= reachedLimit %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>Пытались скачать сверх лимита (6-й+ трек):</span>
                <span class="badge bg-warning text-dark rounded-pill"><%= attemptedOverLimit %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>Открыли меню тарифов после лимита:</span>
                <span class="badge bg-info rounded-pill"><%= openedOffersAfterLimit %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>Оплатили тариф после лимита:</span>
                <span class="badge bg-success rounded-pill"><%= paidAfterLimit %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>Вернулись на следующий день после лимита:</span>
                <span class="badge bg-primary rounded-pill"><%= returnedNextDay %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>Прекратили активность (Churmed) после лимита:</span>
                <span class="badge bg-secondary rounded-pill"><%= churnedAfterLimit %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <%# Historical Data Table %>
    <div class="card shadow-sm">
      <div class="card-header bg-white fw-bold"><i class="bi bi-table me-2 text-secondary"></i>Детальная статистика по дням</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th>Дата</th>
                <th class="text-center">DAU</th>
                <th class="text-center">WAU</th>
                <th class="text-center">MAU</th>
                <th class="text-center">Регистрации</th>
                <th class="text-center">Скачиваний</th>
                <th class="text-center">Кэш / Новые</th>
                <th class="text-center">Лимиты</th>
                <th class="text-end">Выручка RUB</th>
                <th class="text-end">Выручка Stars</th>
              </tr>
            </thead>
            <tbody>
              <% if (dailyRows.length === 0) { %>
                <tr><td colspan="10" class="text-center py-4 text-muted">Нет данных для отображения</td></tr>
              <% } else { %>
                <% dailyRows.forEach(row => { %>
                  <tr>
                    <td class="fw-semibold"><%= new Date(row.day).toLocaleDateString('ru-RU', { timeZone: 'UTC' }) %></td>
                    <td class="text-center"><%= row.dau %></td>
                    <td class="text-center text-muted"><%= row.wau %></td>
                    <td class="text-center text-muted"><%= row.mau %></td>
                    <td class="text-center text-success fw-bold">+<%= row.registrations %></td>
                    <td class="text-center fw-bold"><%= row.downloads_total %></td>
                    <td class="text-center text-muted"><%= row.downloads_from_cache %> / <%= row.downloads_new %></td>
                    <td class="text-center text-danger"><%= row.limits_reached %></td>
                    <td class="text-end text-success"><%= (row.revenue_rub_minor / 100).toFixed(2) %> ₽</td>
                    <td class="text-end text-warning">⭐️ <%= row.revenue_xtr %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- Вкладка 2: Сравнение периодов -->
  <div class="tab-pane fade" id="compare-pane" role="tabpanel" aria-labelledby="compare-tab">
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-bold"><i class="bi bi-arrow-left-right me-2 text-primary"></i>Настройка сравнения периодов</div>
      <div class="card-body">
        <form id="comparison-form" class="row g-3 align-items-end">
          <div class="col-md-5">
            <label class="form-label fw-semibold text-muted">Период A</label>
            <div class="d-flex gap-2">
              <input type="date" id="comp-start-A" class="form-control form-control-sm" required>
              <input type="date" id="comp-end-A" class="form-control form-control-sm" required>
            </div>
          </div>
          <div class="col-md-5">
            <label class="form-label fw-semibold text-muted">Период Б</label>
            <div class="d-flex gap-2">
              <input type="date" id="comp-start-B" class="form-control form-control-sm" required>
              <input type="date" id="comp-end-B" class="form-control form-control-sm" required>
            </div>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary w-100 py-2" id="btn-run-compare">Сравнить</button>
          </div>
          
          <!-- Пресеты -->
          <div class="col-12 mt-2">
            <span class="text-muted small me-2">Быстрые пресеты:</span>
            <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 small me-2" onclick="setPreset('7d')">7 дней vs Предыдущие 7 дней</button>
            <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 small me-2" onclick="setPreset('30d')">Текущий месяц vs Прошлый месяц</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Результаты сравнения -->
    <div class="card shadow-sm d-none" id="compare-results-card">
      <div class="card-header bg-white fw-bold"><i class="bi bi-grid-3x3 me-2 text-success"></i>Сравнительная таблица</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th>Показатель (Бизнес-метрика)</th>
                <th class="text-center" id="lbl-period-A">Период А</th>
                <th class="text-center" id="lbl-period-B">Период Б</th>
                <th class="text-end">Абсолютное изменение</th>
                <th class="text-end">Процентное изменение</th>
              </tr>
            </thead>
            <tbody id="compare-tbody">
              <!-- Сюда подставится JS данные -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Вкладка 3: Когортный анализ -->
  <div class="tab-pane fade" id="cohorts-pane" role="tabpanel" aria-labelledby="cohorts-tab">
    <div class="card shadow-sm">
      <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Месячные когорты удержания (Retention)</span>
        <button class="btn btn-xs btn-primary py-1 px-3 fw-bold" onclick="loadCohorts()">
          <i class="bi bi-arrow-clockwise me-1"></i>Загрузить когорты
        </button>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-bordered mb-0 align-middle text-center text-nowrap">
            <thead class="table-light">
              <tr>
                <th>Месяц регистрации</th>
                <th>Размер когорты</th>
                <th style="width: 15%;">Day 1 Retention</th>
                <th style="width: 15%;">Day 7 Retention</th>
                <th style="width: 15%;">Day 30 Retention</th>
                <th style="width: 15%;">Day 90 Retention</th>
              </tr>
            </thead>
            <tbody id="cohorts-tbody">
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  Нажмите кнопку <b>«Загрузить когорты»</b> для построения тепловой карты удержания.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Вкладка 4: Мониторинг денег -->
  <div class="tab-pane fade" id="revenue-pane" role="tabpanel" aria-labelledby="revenue-tab">
    
    <!-- Финансовые карточки -->
    <div class="row g-3 mb-4" id="revenue-cards-container">
      <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
          <div class="card-body">
            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Выручка сегодня</div>
            <div class="h4 mb-0 font-weight-bold text-gray-800" id="rev-today-val">—</div>
            <div class="text-muted text-xs mt-1" id="rev-today-sub">Заказов: —</div>
          </div>
        </div>
      </div>
