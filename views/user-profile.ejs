<%
  const escapeHtml = value => String(value ?? '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  const formatDate = value => {
    if (!value) return '—';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return '—';
    return parsed.toLocaleString('ru-RU', {
      timeZone: 'Europe/Moscow', year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit'
    });
  };
  const formatDateOnly = value => {
    if (!value) return '—';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return '—';
    return parsed.toLocaleDateString('ru-RU', {
      timeZone: 'Europe/Moscow', year: 'numeric', month: '2-digit', day: '2-digit'
    });
  };
  const u = typeof userProfile !== 'undefined' && userProfile ? userProfile : {};
  const safeName = escapeHtml(u.first_name);
  const safeUsername = escapeHtml(u.username);
  const displayName = safeName || safeUsername || `ID: ${escapeHtml(u.id || '???')}`;
  const qParams = typeof queryParams !== 'undefined' && queryParams ? queryParams : {};
  const safeActions = typeof actions !== 'undefined' && Array.isArray(actions) ? actions : [];
  const safeDownloads = typeof downloads !== 'undefined' && Array.isArray(downloads) ? downloads : [];
  const safeLanguageHistory = typeof languageHistory !== 'undefined' && Array.isArray(languageHistory) ? languageHistory : [];
  const safeReferredUsers = typeof referredUsers !== 'undefined' && Array.isArray(referredUsers) ? referredUsers : [];
  const safeReferrer = typeof referrer !== 'undefined' && referrer ? referrer : null;
  const profileSource = safeReferrer ? 'Реферал' : (u.referral_source ? escapeHtml(u.referral_source) : 'Organic');
  const paymentActions = safeActions.filter(item => /payment|stars|invoice/i.test(String(item.action_type || '')));
  const subscriptionActions = safeActions.filter(item => /tariff|subscription|premium|gift|grant/i.test(String(item.action_type || '')));
  const freeLimit = parseInt(getSetting('daily_limit_free') || '3', 10);
  const plusLimit = parseInt(getSetting('daily_limit_plus') || '30', 10);
  const proLimit = parseInt(getSetting('daily_limit_pro') || '100', 10);
  const premiumUntil = u.premium_until ? new Date(u.premium_until) : null;
  const premiumActive = Boolean(premiumUntil && !Number.isNaN(premiumUntil.getTime()) && premiumUntil > new Date());
  const unlimited = premiumActive && u.premium_limit === null;
  let planName = 'Free';
  let planClass = 'text-bg-secondary';
  if (unlimited) { planName = 'Unlimited'; planClass = 'text-bg-primary'; }
  else if (premiumActive && Number(u.premium_limit) === plusLimit) { planName = 'Plus'; planClass = 'text-bg-info'; }
  else if (premiumActive && Number(u.premium_limit) === proLimit) { planName = 'Pro'; planClass = 'text-bg-warning'; }
  else if (premiumActive && Number(u.premium_limit) > freeLimit) { planName = `Тариф ${u.premium_limit}`; planClass = 'text-bg-primary'; }
  const expiredPremium = Boolean(!premiumActive && premiumUntil && (u.premium_limit === null || Number(u.premium_limit) > freeLimit));
  const currentLimit = unlimited ? null : (premiumActive ? Number(u.premium_limit || freeLimit) : freeLimit);
  const downloadsToday = Number(u.downloads_today || 0);
  const limitPercent = unlimited ? 0 : Math.min(100, Math.round(downloadsToday / Math.max(currentLimit, 1) * 100));
  const progressClass = limitPercent >= 100 ? 'bg-danger' : limitPercent > 75 ? 'bg-warning' : 'bg-success';
  const actionMap = {
    registration: { name: 'Регистрация', class: 'text-bg-light border' },
    bonus_received: { name: 'Бонус', class: 'text-bg-success' },
    tariff_changed_by_admin: { name: 'Смена тарифа', class: 'text-bg-warning' },
    banned_by_admin: { name: 'Блокировка', class: 'text-bg-danger' },
    unbanned_by_admin: { name: 'Разблокировка', class: 'text-bg-success' },
    referral_bonus_received: { name: 'Реферальный бонус', class: 'text-bg-info' },
    karaoke_tester_activated: { name: 'Тест Karaoke', class: 'text-bg-primary' }
  };
%>

<%- contentFor('styles') %>
<style>
  .profile-workspace { max-width: 1800px; margin: 0 auto; min-width: 0; overflow-x: clip; }
  .profile-card, .profile-header-card {
    border: 1px solid var(--bs-border-color);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }
  .profile-card:hover, .profile-header-card:hover { transform: none; box-shadow: var(--shadow-sm); }
  .profile-card > .card-header {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .8rem 1rem;
    background: var(--table-header-bg) !important;
    color: var(--bs-body-color) !important;
    border-bottom: 1px solid var(--bs-border-color);
    font-size: 1rem;
    letter-spacing: 0;
  }
  .profile-card > .card-body { padding: 1.15rem; }
  .profile-header-card .card-body { padding: 1.25rem; }
  .profile-avatar {
    width: 74px;
    height: 74px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 20px;
    color: #fff;
    font-size: 1.8rem;
    font-weight: 750;
    background: linear-gradient(135deg, var(--bs-primary-color), #6f42c1);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--bs-primary-color) 25%, transparent);
  }
  .profile-heading { min-width: 0; }
  .profile-heading h1, .profile-heading .username { overflow-wrap: anywhere; }
  .profile-workspace code { white-space: normal; overflow-wrap: anywhere; }
  .profile-workspace .text-muted { color: var(--bs-body-color) !important; opacity: .68; }
  .profile-header-meta { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .65rem; }
  .profile-header-meta .badge { font-weight: 600; }
  .profile-header-main {
    display: grid;
    grid-template-columns: minmax(270px, 1fr) minmax(420px, 1.35fr) auto;
    gap: 1rem;
    align-items: center;
  }
  .profile-identity { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .profile-summary-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: .65rem;
    min-width: 0;
  }
  .profile-summary-item {
    grid-column: span 2;
    min-width: 0;
    padding: .7rem .8rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 10px;
    background: var(--table-header-bg);
  }
  .profile-summary-item:nth-child(n+4) { grid-column: span 3; }
  .profile-summary-label { color: var(--bs-body-color); opacity: .68; font-size: .72rem; font-weight: 650; text-transform: uppercase; letter-spacing: .035em; }
  .profile-summary-value { margin-top: .2rem; font-size: .92rem; font-weight: 700; overflow-wrap: anywhere; }
  .profile-header-actions { display: flex; gap: .5rem; flex-wrap: wrap; justify-content: flex-end; }
  .profile-header-actions .btn { min-height: 34px; display: inline-flex; align-items: center; justify-content: center; }
  .profile-columns { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 1.25rem; align-items: start; }
  .profile-stack { display: grid; gap: 1.25rem; min-width: 0; }
  .info-list { display: grid; grid-template-columns: minmax(130px, 42%) minmax(0, 1fr); gap: .7rem 1rem; margin: 0; }
  .info-list dt { color: var(--bs-body-color); opacity: .68; font-size: .86rem; font-weight: 600; }
  .info-list dd { margin: 0; min-width: 0; overflow-wrap: anywhere; font-weight: 550; }
  .info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .info-field {
    min-width: 0;
    padding: .75rem .8rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 10px;
    background: var(--table-header-bg);
  }
  .info-field-label { color: var(--bs-body-color); opacity: .68; font-size: .78rem; font-weight: 650; }
  .info-field-value { margin-top: .25rem; min-width: 0; font-size: .95rem; font-weight: 650; overflow-wrap: anywhere; }
  .limit-panel { padding: .85rem; border: 1px solid var(--bs-border-color); border-radius: 10px; background: var(--table-header-bg); }
  .limit-panel .progress { height: 12px; background: color-mix(in srgb, var(--bs-border-color) 65%, transparent); }
  .activity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .activity-stat { padding: .85rem; border-radius: 10px; background: var(--table-header-bg); border: 1px solid var(--bs-border-color); }
  .activity-stat .value { font-size: 1.35rem; line-height: 1.1; font-weight: 750; overflow-wrap: anywhere; }
  .language-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .language-actions .btn { min-width: 120px; }
  .profile-form-grid { --bs-gutter-x: .75rem; --bs-gutter-y: .65rem; }
  .profile-form-grid .form-label { min-height: 1.1rem; margin-bottom: .2rem !important; }
  .profile-form-grid .form-control, .profile-form-grid .form-select { min-width: 0; }
  .profile-action-grid { display: flex; flex-wrap: wrap; gap: .55rem; }
  .profile-action-grid form { display: inline-flex; }
  .profile-table-wrap { width: 100%; max-width: 100%; max-height: 390px; overflow: auto; overscroll-behavior-inline: contain; }
  .profile-table-wrap .table { margin-top: 0; min-width: 680px; }
  .profile-table-wrap .table th, .profile-table-wrap .table td { padding: .7rem .8rem; }
  .compact-table { font-size: .86rem; }
  .empty-card-state { padding: 1.25rem 1rem; text-align: center; color: var(--bs-body-color); opacity: .68; }
  .profile-balanced-card, .profile-history-card { min-height: 174px; }
  .profile-history-card .empty-card-state { min-height: 120px; display: grid; place-content: center; }
  .service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .service-panel { padding: 1rem; border: 1px solid var(--bs-border-color); border-radius: 10px; background: var(--table-header-bg); }
  .text-break-safe { overflow-wrap: anywhere; word-break: break-word; }
  [data-theme="dark"] .profile-workspace .text-bg-light,
  [data-theme="dark"] .profile-workspace .bg-light {
    color: var(--bs-body-color) !important;
    background: var(--table-header-bg) !important;
  }

  @media (max-width: 1199.98px) {
    .profile-columns { grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr); }
    .profile-header-main { grid-template-columns: minmax(270px, 1fr) auto; }
    .profile-summary-grid { grid-column: 1 / -1; }
    .service-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 991.98px) {
    .profile-columns { grid-template-columns: 1fr; }
    .profile-header-main { grid-template-columns: 1fr auto; align-items: start; }
    .profile-summary-grid { grid-column: 1 / -1; }
    .profile-header-actions { justify-content: flex-start; }
  }
  @media (max-width: 575.98px) {
    .profile-header-card .card-body, .profile-card > .card-body { padding: 1rem; }
    .profile-avatar { width: 58px; height: 58px; border-radius: 16px; font-size: 1.4rem; }
    .profile-header-main { grid-template-columns: 1fr; }
    .profile-identity, .profile-summary-grid, .profile-header-actions { grid-column: 1; width: 100%; }
    .profile-identity { align-items: flex-start; }
    .profile-heading { min-width: 0; }
    .profile-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .profile-summary-item, .profile-summary-item:nth-child(n+4) { grid-column: span 1; }
    .profile-summary-item:first-child { grid-column: 1 / -1; }
    .profile-header-actions .btn { flex: 1 1 100%; }
    .info-list { grid-template-columns: 1fr; gap: .2rem; }
    .info-list dd { margin-bottom: .55rem; }
    .info-grid, .activity-grid, .service-grid { grid-template-columns: 1fr; }
    .language-actions .btn { min-width: 0; flex: 1 1 auto; }
    .profile-action-grid form, .profile-action-grid .btn { width: 100%; }
    .profile-table-wrap .table { min-width: 620px; }
  }
</style>

<%- contentFor('body') %>
<% if (u.id) { %>
<div class="profile-workspace">
  <section class="card profile-header-card mb-4">
    <div class="card-body">
      <div class="profile-header-main">
        <div class="profile-identity">
          <div class="profile-avatar"><%= String(displayName).charAt(0).toUpperCase() %></div>
          <div class="profile-heading">
            <h1 class="h3 mb-1"><%- displayName %></h1>
            <div class="username text-muted"><%- safeUsername ? `@${safeUsername}` : 'Username не указан' %></div>
            <div class="profile-header-meta">
              <span class="badge <%= u.active ? 'text-bg-success' : 'text-bg-danger' %>"><%= u.active ? 'Активен' : 'Заблокирован' %></span>
              <% if (expiredPremium) { %><span class="badge text-bg-danger">Premium истёк</span><% } %>
            </div>
          </div>
        </div>
        <div class="profile-summary-grid" aria-label="Сводка по пользователю">
          <div class="profile-summary-item"><div class="profile-summary-label">Telegram ID</div><div class="profile-summary-value"><code><%= u.id %></code></div></div>
          <div class="profile-summary-item"><div class="profile-summary-label">Тариф</div><div class="profile-summary-value"><span class="badge <%= planClass %>"><%= planName %></span></div></div>
          <div class="profile-summary-item"><div class="profile-summary-label">Источник</div><div class="profile-summary-value"><%- profileSource %></div></div>
          <div class="profile-summary-item"><div class="profile-summary-label">Регистрация</div><div class="profile-summary-value"><%= formatDateOnly(u.created_at) %></div></div>
          <div class="profile-summary-item"><div class="profile-summary-label">Последняя активность</div><div class="profile-summary-value"><%= formatDateOnly(u.last_active) %></div></div>
        </div>
        <div class="profile-header-actions">
          <a href="/admin/user-journey?user_id=<%= encodeURIComponent(u.id) %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-signpost-split me-1"></i>Путь пользователя</a>
          <a href="/users" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Назад к списку</a>
        </div>
      </div>
    </div>
  </section>

  <% if (qParams.fixedCount) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-magic me-2"></i><strong>Успешно:</strong> сброшен кэш для <b><%= qParams.fixedCount %></b> треков до <%= qParams.fixedDate %>.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
  <% } %>

  <div class="profile-columns">
    <div class="profile-stack">
      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-person-vcard me-2 text-primary"></i>Информация о пользователе</span></div>
        <div class="card-body">
          <div class="info-grid">
            <div class="info-field"><div class="info-field-label">Telegram ID</div><div class="info-field-value"><code class="text-break-safe"><%= u.id %></code></div></div>
            <div class="info-field"><div class="info-field-label">Имя</div><div class="info-field-value"><%- safeName || '<span class="text-muted">Не указано</span>' %></div></div>
            <div class="info-field"><div class="info-field-label">Username</div><div class="info-field-value"><%- safeUsername ? `<a href="https://t.me/${encodeURIComponent(String(u.username))}" target="_blank" rel="noopener">@${safeUsername}</a>` : '<span class="text-muted">Не указан</span>' %></div></div>
            <div class="info-field"><div class="info-field-label">Статус</div><div class="info-field-value"><span class="badge <%= u.active ? 'text-bg-success' : 'text-bg-danger' %>"><%= u.active ? 'Активен' : 'Заблокирован' %></span></div></div>
            <div class="info-field"><div class="info-field-label">Источник</div><div class="info-field-value">
              <% if (safeReferrer) { %>Приглашён: <a href="/user/<%= safeReferrer.id %>"><%- escapeHtml(safeReferrer.first_name || safeReferrer.username || safeReferrer.id) %></a>
              <% } else if (u.referral_source) { %><span class="badge text-bg-secondary"><%- escapeHtml(u.referral_source) %></span>
              <% } else { %><span class="text-muted">Органический / неизвестный</span><% } %>
            </div></div>
            <div class="info-field"><div class="info-field-label">Тариф</div><div class="info-field-value"><span class="badge <%= planClass %>"><%= planName %></span></div></div>
            <div class="info-field"><div class="info-field-label">Подписка до</div><div class="info-field-value"><%= formatDate(u.premium_until) %></div></div>
            <div class="info-field"><div class="info-field-label">Регистрация</div><div class="info-field-value"><%= formatDate(u.created_at) %></div></div>
            <div class="info-field"><div class="info-field-label">Последняя активность</div><div class="info-field-value"><%= formatDate(u.last_active) %></div></div>
          </div>
          <div class="limit-panel mt-3">
            <div class="d-flex justify-content-between gap-3 mb-2"><span class="small fw-semibold">Лимит сегодня</span><span class="small fw-bold"><%= downloadsToday %> / <%= unlimited ? '∞' : currentLimit %></span></div>
            <div class="progress" role="progressbar" aria-label="Дневной лимит" aria-valuenow="<%= unlimited ? 0 : limitPercent %>" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar <%= progressClass %>" style="width:<%= unlimited ? 100 : limitPercent %>%"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-translate me-2 text-primary"></i>Языковые настройки</span><span class="badge text-bg-info"><%- escapeHtml(u.language_source || 'legacy_default') %></span></div>
        <div class="card-body">
          <dl class="info-list mb-3">
            <dt>Текущий язык</dt><dd><%= u.language_code === 'ru' ? '🇷🇺 Русский (ru)' : u.language_code === 'en' ? '🇬🇧 English (en)' : `❓ Неизвестно (${escapeHtml(u.language_code || '—')})` %></dd>
            <dt>Код Telegram</dt><dd><code><%- escapeHtml(u.telegram_language_code || '—') %></code></dd>
            <dt>Последнее изменение</dt><dd><%= formatDate(u.language_updated_at) %></dd>
          </dl>
          <form class="language-actions" method="POST" action="/user/<%= u.id %>/set-language" onsubmit="return confirm('Изменить язык пользователя?');">
            <button type="submit" name="lang" value="ru" class="btn btn-sm <%= u.language_code === 'ru' ? 'btn-primary' : 'btn-outline-primary' %>">🇷🇺 RU</button>
            <button type="submit" name="lang" value="en" class="btn btn-sm <%= u.language_code === 'en' ? 'btn-primary' : 'btn-outline-primary' %>">🇬🇧 EN</button>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-bs-toggle="collapse" data-bs-target="#language-history" aria-expanded="false"><i class="bi bi-clock-history me-1"></i>История (<%= safeLanguageHistory.length %>)</button>
          </form>
          <div class="collapse mt-3" id="language-history">
            <% if (safeLanguageHistory.length) { %>
              <div class="profile-table-wrap"><table class="table table-sm table-hover compact-table mb-0"><thead><tr><th>Дата</th><th>Язык</th><th>Источник</th><th>Изменил</th></tr></thead><tbody>
                <% safeLanguageHistory.forEach(h => { %><tr><td class="text-nowrap"><%= formatDate(h.created_at) %></td><td><code><%- escapeHtml(h.previous_language || '—') %></code> → <code><%- escapeHtml(h.new_language || '—') %></code></td><td><%- escapeHtml(h.new_source || '—') %></td><td><%- h.changed_by_type === 'admin' ? `Админ (${escapeHtml(h.changed_by_user_id)})` : 'Автоматически' %></td></tr><% }) %>
              </tbody></table></div>
            <% } else { %><div class="empty-card-state"><i class="bi bi-clock-history d-block fs-4 mb-2"></i>История языка отсутствует</div><% } %>
          </div>
        </div>
      </section>

      <section class="card profile-card profile-balanced-card">
        <div class="card-header"><span><i class="bi bi-activity me-2 text-primary"></i>Краткая статистика активности</span></div>
        <div class="card-body">
          <div class="activity-grid">
            <div class="activity-stat"><div class="small text-muted">Всего скачиваний</div><div class="value"><%= Number(u.total_downloads || 0).toLocaleString('ru-RU') %></div></div>
            <div class="activity-stat"><div class="small text-muted">Сегодня</div><div class="value"><%= downloadsToday.toLocaleString('ru-RU') %></div></div>
            <div class="activity-stat"><div class="small text-muted">Последних треков</div><div class="value"><%= safeDownloads.length %></div></div>
            <div class="activity-stat"><div class="small text-muted">Приглашено</div><div class="value"><%= safeReferredUsers.length %></div></div>
          </div>
        </div>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-person-plus me-2 text-primary"></i>Приглашённые пользователи</span><span class="badge text-bg-light border"><%= safeReferredUsers.length %></span></div>
        <% if (safeReferredUsers.length) { %><div class="list-group list-group-flush" style="max-height:260px;overflow:auto"><% safeReferredUsers.forEach(refUser => { %><a href="/user/<%= refUser.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3"><span class="text-break-safe"><strong><%- escapeHtml(refUser.first_name || refUser.username || 'Без имени') %></strong><small class="text-muted d-block">ID <%= refUser.id %></small></span><small class="text-muted text-nowrap"><%= formatDate(refUser.created_at) %></small></a><% }) %></div>
        <% } else { %><div class="empty-card-state"><i class="bi bi-people d-block fs-4 mb-2"></i>Приглашённых пользователей нет</div><% } %>
      </section>
    </div>

    <div class="profile-stack">
      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-gem me-2 text-primary"></i>Управление тарифом</span><span class="badge <%= planClass %>"><%= planName %></span></div>
        <div class="card-body">
          <p class="small text-muted mb-3">Нефинансовая корректировка доступа. Платёж не создаётся.</p>
          <form class="row g-3 profile-form-grid" method="post" action="/set-tariff" onsubmit="return confirm('Изменить тариф для этого пользователя?');">
            <input type="hidden" name="userId" value="<%= u.id %>">
            <div class="col-xl-3 col-md-6"><label class="form-label small text-muted mb-1">Тариф</label><select name="limit" class="form-select form-select-sm" required><option value="<%= freeLimit %>" <%= !premiumActive ? 'selected' : '' %>>Free (<%= freeLimit %>)</option><option value="<%= plusLimit %>" <%= premiumActive && Number(u.premium_limit) === plusLimit ? 'selected' : '' %>>Plus (<%= plusLimit %>)</option><option value="<%= proLimit %>" <%= premiumActive && Number(u.premium_limit) === proLimit ? 'selected' : '' %>>Pro (<%= proLimit %>)</option><option value="unlim" <%= unlimited ? 'selected' : '' %>>Unlimited</option></select></div>
            <div class="col-xl-2 col-md-6"><label class="form-label small text-muted mb-1">Дней</label><input type="number" name="days" class="form-control form-control-sm" value="30" min="1" max="999" required></div>
            <div class="col-xl-3 col-md-6"><label class="form-label small text-muted mb-1">Тип операции</label><select name="opType" class="form-select form-select-sm" required><option value="adjustment" selected>Корректировка</option><option value="gift">Подарок</option><option value="test_grant">Тестовый доступ</option></select></div>
            <div class="col-xl-4 col-md-6"><label class="form-label small text-muted mb-1">Комментарий</label><input type="text" name="comment" class="form-control form-control-sm" placeholder="Причина (необязательно)"></div>
            <div class="col-lg-8 d-flex flex-wrap align-items-center gap-3"><div class="form-check"><input class="form-check-input" type="radio" name="applyMode" id="applyModeSet" value="set" checked><label class="form-check-label small" for="applyModeSet">Установить с новой датой</label></div><div class="form-check"><input class="form-check-input" type="radio" name="applyMode" id="applyModeExtend" value="extend"><label class="form-check-label small" for="applyModeExtend">Продлить текущую подписку</label></div></div>
            <div class="col-lg-4 d-grid d-lg-flex justify-content-lg-end"><button type="submit" class="btn btn-sm btn-primary px-4">Сохранить</button></div>
          </form>
        </div>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-cash-coin me-2 text-success"></i>Регистрация ручного платежа</span><span class="badge text-bg-light border">Только RUB</span></div>
        <div class="card-body">
          <form class="row g-3 profile-form-grid" method="post" action="/register-manual-payment" onsubmit="return confirm('Подтвердить регистрацию платежа и зачисление тарифа?');">
            <input type="hidden" name="userId" value="<%= u.id %>">
            <div class="col-lg-4 col-md-6"><label class="form-label small text-muted mb-1">Тариф</label><select name="plan" class="form-select form-select-sm" required><option value="plus" selected>Plus</option><option value="pro">Pro</option><option value="unlim">Unlimited</option></select></div>
            <div class="col-lg-4 col-md-6"><label class="form-label small text-muted mb-1">Сумма в копейках</label><input type="number" name="amountMinor" class="form-control form-control-sm" placeholder="11900 = 119 ₽" min="1" required></div>
            <div class="col-lg-4 col-md-6"><label class="form-label small text-muted mb-1">Валюта</label><select name="currency" class="form-select form-select-sm" required><option value="RUB" selected>RUB</option></select></div>
            <div class="col-lg-4 col-md-6"><label class="form-label small text-muted mb-1">Способ оплаты</label><select name="paymentMethod" class="form-select form-select-sm" required><option value="tbank" selected>Т-Банк</option><option value="sbp">СБП</option><option value="boosty">Boosty</option><option value="other_manual">Другой перевод</option></select></div>
            <div class="col-lg-4 col-md-6"><label class="form-label small text-muted mb-1">Период, дней</label><input type="number" name="periodDays" class="form-control form-control-sm" value="30" min="1" max="999" required></div>
            <div class="col-lg-4 col-md-6"><label class="form-label small text-muted mb-1">Комментарий</label><input type="text" name="comment" class="form-control form-control-sm" placeholder="Транзакция или детали"></div>
            <div class="col-12 d-grid d-md-flex justify-content-md-end"><button type="submit" class="btn btn-sm btn-success px-4"><i class="bi bi-check-circle me-1"></i>Провести платёж</button></div>
          </form>
        </div>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-sliders me-2 text-primary"></i>Нефинансовые операции</span></div>
        <div class="card-body profile-action-grid">
          <form action="/user/set-status" method="POST"><input type="hidden" name="userId" value="<%= u.id %>"><input type="hidden" name="newStatus" value="<%= u.active ? 'false' : 'true' %>"><button type="submit" class="btn btn-sm <%= u.active ? 'btn-outline-danger' : 'btn-success' %>" onclick="return confirm('<%= u.active ? 'Заблокировать пользователя?' : 'Разблокировать пользователя?' %>');"><i class="bi <%= u.active ? 'bi-ban' : 'bi-check-circle' %> me-1"></i><%= u.active ? 'Заблокировать' : 'Разблокировать' %></button></form>
          <form action="/reset-daily-limit" method="POST"><input type="hidden" name="userId" value="<%= u.id %>"><button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Сбросить дневной лимит?');"><i class="bi bi-arrow-counterclockwise me-1"></i>Сбросить лимит</button></form>
          <form action="/reset-bonus" method="POST"><input type="hidden" name="userId" value="<%= u.id %>"><button type="submit" class="btn btn-sm btn-outline-info" onclick="return confirm('Сбросить использование бонуса?');"><i class="bi bi-gift me-1"></i>Сбросить бонус</button></form>
          <form action="/admin/queue/clear-user" method="POST"><input type="hidden" name="userId" value="<%= u.id %>"><button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Очистить очередь загрузок пользователя?');"><i class="bi bi-eraser me-1"></i>Очистить очередь</button></form>
        </div>
      </section>

      <section class="card profile-card profile-balanced-card profile-history-card">
        <div class="card-header"><span><i class="bi bi-receipt me-2 text-success"></i>История платежей</span><span class="badge text-bg-light border"><%= paymentActions.length %></span></div>
        <% if (paymentActions.length) { %><div class="profile-table-wrap"><table class="table table-hover compact-table mb-0"><thead><tr><th>Событие</th><th>Детали</th><th>Дата</th></tr></thead><tbody><% paymentActions.forEach(action => { %><tr><td><%- escapeHtml(action.action_type) %></td><td class="text-break-safe"><%- action.details ? escapeHtml(JSON.stringify(action.details)) : '—' %></td><td class="text-nowrap"><%= formatDate(action.created_at) %></td></tr><% }) %></tbody></table></div>
        <% } else { %><div class="empty-card-state"><i class="bi bi-receipt d-block fs-4 mb-2"></i>В журнале действий нет платежных событий</div><% } %>
      </section>

      <section class="card profile-card profile-balanced-card profile-history-card">
        <div class="card-header"><span><i class="bi bi-calendar2-check me-2 text-primary"></i>История подписок</span><span class="badge text-bg-light border"><%= subscriptionActions.length %></span></div>
        <% if (subscriptionActions.length) { %><div class="profile-table-wrap"><table class="table table-hover compact-table mb-0"><thead><tr><th>Операция</th><th>Детали</th><th>Дата</th></tr></thead><tbody><% subscriptionActions.forEach(action => { const presented=actionMap[action.action_type]||{name:escapeHtml(action.action_type),class:'text-bg-light border'}; %><tr><td><span class="badge <%= presented.class %>"><%- presented.name %></span></td><td class="text-break-safe"><%- action.details ? escapeHtml(JSON.stringify(action.details)) : '—' %></td><td class="text-nowrap"><%= formatDate(action.created_at) %></td></tr><% }) %></tbody></table></div>
        <% } else { %><div class="empty-card-state"><i class="bi bi-calendar2-x d-block fs-4 mb-2"></i>История подписок отсутствует</div><% } %>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-music-note-list me-2 text-primary"></i>История скачиваний</span><span class="badge text-bg-light border"><%= safeDownloads.length %></span></div>
        <% if (safeDownloads.length) { %><div class="profile-table-wrap"><table class="table table-hover compact-table mb-0"><thead><tr><th>Трек</th><th>Дата</th></tr></thead><tbody><% safeDownloads.forEach(item => { %><tr><td class="text-break-safe"><%- escapeHtml(item.track_title || 'Без названия') %><% if (item.url) { %> <a href="<%- escapeHtml(item.url) %>" target="_blank" rel="noopener" title="Открыть"><i class="bi bi-box-arrow-up-right"></i></a><% } %></td><td class="text-nowrap"><%= formatDate(item.created_at || item.downloaded_at) %></td></tr><% }) %></tbody></table></div>
        <% } else { %><div class="empty-card-state"><i class="bi bi-music-note d-block fs-4 mb-2"></i>Скачиваний нет</div><% } %>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-list-check me-2 text-primary"></i>Действия администратора и системы</span><span class="badge text-bg-light border"><%= safeActions.length %></span></div>
        <% if (safeActions.length) { %><div class="profile-table-wrap"><table class="table table-hover compact-table mb-0"><thead><tr><th>Тип</th><th>Детали</th><th>Время</th></tr></thead><tbody><% safeActions.forEach(action => { const presented=actionMap[action.action_type]||{name:escapeHtml(action.action_type),class:'text-bg-light border'}; %><tr><td><span class="badge <%= presented.class %>"><%- presented.name %></span></td><td class="text-break-safe"><%- action.details ? escapeHtml(JSON.stringify(action.details)) : '—' %></td><td class="text-nowrap"><%= formatDate(action.created_at) %></td></tr><% }) %></tbody></table></div>
        <% } else { %><div class="empty-card-state"><i class="bi bi-journal-x d-block fs-4 mb-2"></i>Действий нет</div><% } %>
      </section>

      <section class="card profile-card">
        <div class="card-header"><span><i class="bi bi-tools me-2 text-warning"></i>Служебная информация</span></div>
        <div class="card-body service-grid">
          <div class="service-panel">
            <h3 class="h6"><i class="bi bi-wrench-adjustable me-1"></i>Управление кэшем</h3>
            <p class="small text-muted">Сбросить старые записи пользователя до выбранной даты.</p>
            <form action="/admin/user/<%= u.id %>/fix-cache" method="POST"><label for="fixDate" class="form-label small">Сбросить треки до</label><input type="date" class="form-control form-control-sm mb-2" id="fixDate" name="fixDate" value="<%= new Date().toISOString().split('T')[0] %>" required><button type="submit" class="btn btn-sm btn-outline-danger w-100" onclick="return confirm('Сбросить выбранные записи кэша?');"><i class="bi bi-magic me-1"></i>Исправить кэш</button></form>
          </div>
          <div class="service-panel d-flex flex-column">
            <h3 class="h6"><i class="bi bi-file-earmark-text me-1"></i>Экспорт ссылок</h3>
            <p class="small text-muted flex-grow-1">Скачать уникальные ссылки из истории пользователя.</p>
            <a href="/admin/user/<%= u.id %>/links" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i>Скачать .txt</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<% } else { %>
  <div class="profile-workspace"><div class="alert alert-danger"><h1 class="h4 alert-heading">Пользователь не найден</h1><p>Не удалось загрузить данные пользователя.</p><a href="/users" class="btn btn-sm btn-outline-danger">Вернуться к списку</a></div></div>
<% } %>
