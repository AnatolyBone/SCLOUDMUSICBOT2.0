<%- contentFor('body') %>

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h2 mb-1"><i class="bi bi-megaphone-fill me-2 text-primary"></i>Рекламные кампании</h1>
    <div class="text-muted">Партнёрские, внутренние и кампании Яндекса в единой ротации</div>
  </div>
  <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#createCampaign">Создать кампанию</button>
</div>

<% if (locals.success) { %><div class="alert alert-success">Изменения сохранены.</div><% } %>
<% if (locals.error) { %><div class="alert alert-danger"><strong>Ошибка:</strong> <%= error %></div><% } %>

<div class="btn-group mb-4" role="group" aria-label="Фильтр кампаний">
  <button class="btn btn-outline-primary promo-filter active" data-filter="active">Активные</button>
  <button class="btn btn-outline-primary promo-filter" data-filter="disabled">Выключенные</button>
  <button class="btn btn-outline-primary promo-filter" data-filter="archived">Архивные</button>
  <button class="btn btn-outline-primary promo-filter" data-filter="all">Все</button>
</div>

<% if ((locals.creativeStats || []).length) { %>
<div class="card mb-4"><div class="card-header"><strong>Эффективность креативов</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Вариант</th><th>Медиа</th><th>Показы</th><th>Уник. показы</th><th>Frequency</th><th>Клики всего</th><th>Уник. клики</th><th>CTR</th><th>Unique CTR</th></tr></thead><tbody><% creativeStats.forEach(row=>{ %><tr><td><code><%= row.creative_variant %></code></td><td><%= row.has_media ? 'Да' : 'Нет' %></td><td><%= row.impressions %></td><td><%= row.unique_impressions %></td><td><%= row.unique_impressions ? row.frequency.toFixed(2) : '—' %></td><td><%= row.clicks_total %></td><td><%= row.unique_clicks %></td><td><%= row.impressions ? row.ctr.toFixed(1)+'%' : '—' %></td><td><%= row.unique_impressions ? row.unique_ctr.toFixed(1)+'%' : '—' %></td></tr><% }) %></tbody></table></div><div class="card-footer small text-muted">legacy означает только клики, которые нельзя однозначно связать с показом по campaign/user/message.</div></div>
<% } %>
<% if ((locals.triggerStats || []).length) { %>
<div class="card mb-4"><div class="card-header"><strong>Эффективность по триггеру</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Тип</th><th>Скачиваний при показе</th><th>Показы</th><th>Уник. показы</th><th>Клики всего</th><th>Уник. клики</th><th>CTR</th><th>Unique CTR</th></tr></thead><tbody><% triggerStats.forEach(row=>{ %><tr><td><code><%= row.trigger_type %></code></td><td><%= row.trigger_value || '—' %></td><td><%= row.impressions %></td><td><%= row.unique_impressions %></td><td><%= row.clicks_total %></td><td><%= row.unique_clicks %></td><td><%= row.impressions ? row.ctr.toFixed(1)+'%' : '—' %></td><td><%= row.unique_impressions ? row.unique_ctr.toFixed(1)+'%' : '—' %></td></tr><% }) %></tbody></table></div></div>
<% } %>

<% function dt(value) { return value ? new Date(value).toISOString().slice(0,16) : ''; } %>
<% function metric(c, key) { return Number((stats[c.id] || {})[key] || 0); } %>
<% function campaignFields(c, creating) { %>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Название</label>
      <input class="form-control" name="name" value="<%= c.name || '' %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">promo_key</label>
      <input class="form-control font-monospace" name="promo_key" value="<%= c.promo_key || '' %>" pattern="[a-z0-9_]{1,40}" maxlength="40" <%= creating ? 'required' : 'readonly' %>>
      <div class="form-text"><%= creating ? 'Уникальный ключ: a-z, 0-9, _' : 'Стабильный ключ нельзя менять' %></div>
    </div>
    <div class="col-md-3">
      <label class="form-label">Категория</label>
      <select class="form-select" name="category">
        <% for (const option of ['yandex','internal','partner','custom']) { %>
          <option value="<%= option %>" <%= (c.category || 'custom') === option ? 'selected' : '' %>><%= option %></option>
        <% } %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Когда показывать</label>
      <select class="form-select" name="trigger_type">
        <option value="download_count" <%= (c.trigger_type||'download_count')==='download_count'?'selected':'' %>>После N скачиваний</option>
        <option value="activity_cooldown" <%= c.trigger_type==='activity_cooldown'?'selected':'' %>>Раз в N дней при активности</option>
        <option value="combined" <%= c.trigger_type==='combined'?'selected':'' %>>Любое из условий</option>
        <option value="manual" disabled <%= c.trigger_type==='manual'?'selected':'' %>>Ручной запуск — пока недоступен</option>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Порог скачиваний</label>
      <input type="number" min="1" class="form-control" name="trigger_download_count" value="<%= c.trigger_download_count || c.trigger_downloads || 3 %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Вес ротации</label>
      <input type="number" min="0" class="form-control" name="weight" value="<%= c.weight ?? 1 %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Повторный показ через, дней</label>
      <input type="number" min="0" class="form-control" name="cooldown_days" value="<%= c.cooldown_days ?? 7 %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Общий cooldown категории, дней</label>
      <input type="number" min="0" class="form-control" name="global_category_cooldown_days" value="<%= c.global_category_cooldown_days ?? 7 %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">После клика не показывать, дней</label>
      <input type="number" min="0" class="form-control" name="cooldown_after_click_days" value="<%= c.cooldown_after_click_days ?? 30 %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Максимум показов пользователю</label>
      <input type="number" min="1" class="form-control" name="max_impressions_per_user" value="<%= c.max_impressions_per_user ?? 3 %>" required>
    </div>
    <div class="col-12"><div class="form-text">Временная кампания не отправляется по расписанию: она показывается при следующем безопасном взаимодействии пользователя с ботом после окончания ожидания.</div></div>
    <div class="col-md-4">
      <label class="form-label">Начало</label>
      <input type="datetime-local" class="form-control" name="starts_at" value="<%= dt(c.starts_at) %>">
    </div>
    <div class="col-md-4">
      <label class="form-label">Окончание</label>
      <input type="datetime-local" class="form-control" name="ends_at" value="<%= dt(c.ends_at) %>">
    </div>
    <div class="col-12">
      <label class="form-label">Текст сообщения (Telegram HTML)</label>
      <textarea class="form-control" rows="4" name="message_text" required><%= c.message_text || '' %></textarea>
    </div>
    <div class="col-md-5">
      <label class="form-label">Текст кнопки</label>
      <input class="form-control" name="button_text" value="<%= c.button_text || 'Открыть предложение' %>" required>
    </div>
    <div class="col-md-7">
      <label class="form-label">Целевая ссылка</label>
      <input type="url" class="form-control" name="url" value="<%= c.url || '' %>" placeholder="https://..." required>
    </div>
    <div class="col-12">
      <label class="form-label">Медиа</label>
      <div class="promo-media-drop border rounded p-3 text-center bg-body-tertiary" tabindex="0">
        <input type="file" class="form-control promo-media-input" name="media" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4">
        <div class="form-text mt-2">Перетащите файл сюда или выберите его. Изображение до 10 МБ, MP4 до 20 МБ. SVG и HTML запрещены.</div>
        <div class="promo-media-meta small mt-2"></div>
        <div class="promo-media-preview mt-2">
          <% if (c.media_storage_path && c.id) { %>
            <% if (c.media_type === 'video') { %><video src="/promos/media/<%= c.id %>" controls class="img-fluid rounded" style="max-height:240px"></video><% } else { %><img src="/promos/media/<%= c.id %>" class="img-fluid rounded" style="max-height:240px" alt="Предпросмотр"><% } %>
            <div class="small mt-1"><%= c.media_file_name || 'Медиа' %> · <%= (Number(c.media_file_size || 0)/1024/1024).toFixed(2) %> МБ</div>
          <% } %>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 promo-clear-file">Удалить выбранный файл</button>
        <% if (c.media_storage_path) { %><div class="form-check mt-2 text-start"><input class="form-check-input" type="checkbox" name="remove_media" value="1" id="remove-media-<%= c.id %>"><label class="form-check-label" for="remove-media-<%= c.id %>">Удалить существующее медиа при сохранении</label></div><% } %>
      </div>
    </div>
  </div>
<% } %>

<div class="collapse mb-4" id="createCampaign">
  <div class="card card-body shadow-sm border-primary-subtle">
    <h5 class="mb-3">Новая кампания</h5>
    <form action="/promos/save" method="POST" enctype="multipart/form-data">
      <% campaignFields({category:'custom',weight:1,cooldown_days:7,max_impressions_per_user:3,trigger_downloads:3}, true); %>
      <div class="text-end mt-3"><button class="btn btn-primary">Создать</button></div>
    </form>
  </div>
</div>

<% campaigns.forEach(c => { const s = stats[c.id] || {}; %>
  <div class="card shadow-sm mb-4 promo-campaign-card <%= c.is_active ? '' : 'opacity-75' %>" data-status="<%= c.is_archived ? 'archived' : (c.is_active ? 'active' : 'disabled') %>">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
      <div>
        <span class="badge <%= c.is_system ? 'bg-secondary' : 'bg-primary' %> me-2"><%= c.is_system ? 'Системная' : 'Пользовательская' %></span>
        <strong><%= c.name %></strong>
        <code class="ms-2"><%= c.promo_key %></code>
      </div>
      <div class="d-flex align-items-center gap-3">
        <div class="form-check form-switch m-0">
          <input class="form-check-input toggle-active-btn" type="checkbox" data-id="<%= c.id %>" <%= c.is_active ? 'checked' : '' %>>
        </div>
        <% if (c.is_system) { %>
          <button type="button" class="btn btn-sm btn-outline-secondary promo-action" data-action="reset" data-id="<%= c.id %>">Сбросить настройки</button>
        <% } else if (c.is_archived) { %>
          <button type="button" class="btn btn-sm btn-outline-success promo-action" data-action="restore" data-id="<%= c.id %>">Восстановить</button>
          <button type="button" class="btn btn-sm btn-outline-danger promo-delete" data-id="<%= c.id %>" data-name="<%= c.name %>">Удалить навсегда</button>
        <% } else { %>
          <button type="button" class="btn btn-sm btn-outline-warning promo-action" data-action="archive" data-id="<%= c.id %>">Архивировать</button>
        <% } %>
      </div>
    </div>
    <div class="card-body">
      <div class="table-responsive mb-4">
        <table class="table table-sm table-bordered text-center align-middle mb-0">
          <thead><tr><th>Период</th><th>Показы</th><th>Уник. показы</th><th>Frequency</th><th>Клики всего</th><th>Уник. клики</th><th>CTR</th><th>Unique CTR</th></tr></thead>
          <tbody>
            <% for (const p of [{k:'24h',n:'24 часа'},{k:'7d',n:'7 дней'},{k:'30d',n:'30 дней'},{k:'total',n:'Всё время'}]) { %>
              <tr><td><%= p.n %></td><td><%= metric(c,'impressions_'+p.k) %></td><td><%= metric(c,'unique_impressions_'+p.k) %></td><td><%= metric(c,'unique_impressions_'+p.k) ? metric(c,'frequency_'+p.k).toFixed(2) : '—' %></td><td><%= metric(c,'clicks_total_'+p.k) %></td><td><%= metric(c,'unique_clicks_'+p.k) %></td><td><%= metric(c,'impressions_'+p.k) ? metric(c,'ctr_'+p.k).toFixed(1)+'%' : '—' %></td><td><%= metric(c,'unique_impressions_'+p.k) ? metric(c,'unique_ctr_'+p.k).toFixed(1)+'%' : '—' %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="small text-muted mb-3">Повторные пользователи: <%= metric(c,'repeat_users') %> · Среднее показов: <%= Number(s.avg_impressions || 0).toFixed(2) %> · Последний показ: <%= s.last_shown_at ? new Date(s.last_shown_at).toLocaleString('ru-RU') : '—' %> · Последний клик: <%= s.last_clicked_at ? new Date(s.last_clicked_at).toLocaleString('ru-RU') : '—' %></div>
      <form action="/promos/save" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<%= c.id %>">
        <% campaignFields(c, false); %>
        <div class="text-end mt-3">
          <button class="btn btn-primary">Сохранить настройки</button>
        </div>
      </form>
    </div>
  </div>
<% }) %>

<script>
window.initializePage = function () {
  document.querySelectorAll('.promo-filter').forEach(button=>button.addEventListener('click',()=>{
    document.querySelectorAll('.promo-filter').forEach(item=>item.classList.remove('active'));button.classList.add('active');
    const filter=button.dataset.filter;document.querySelectorAll('.promo-campaign-card').forEach(card=>card.classList.toggle('d-none',filter!=='all'&&card.dataset.status!==filter));
  }));
  document.querySelector('.promo-filter[data-filter="active"]')?.click();
  document.querySelectorAll('.toggle-active-btn').forEach(toggle => toggle.addEventListener('change', async event => {
    const previous = !event.target.checked;
    try {
      const response = await fetch('/promos/toggle', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id:event.target.dataset.id,is_active:event.target.checked})});
      const result = await response.json();
      if (!result.success) throw new Error(result.error || 'Ошибка сохранения');
    } catch (error) {
      event.target.checked = previous;
      alert(error.message);
    }
  }));
  document.querySelectorAll('.promo-media-drop').forEach(drop => {
    const input=drop.querySelector('.promo-media-input'),preview=drop.querySelector('.promo-media-preview'),meta=drop.querySelector('.promo-media-meta');
    const render=file=>{
      if(!file)return;
      const allowed=['image/jpeg','image/png','image/webp','image/gif','video/mp4'];
      const max=file.type==='video/mp4'?20*1024*1024:10*1024*1024;
      if(!allowed.includes(file.type)||file.size>max){input.value='';meta.textContent='Недопустимый формат или размер файла.';meta.className='promo-media-meta small mt-2 text-danger';return;}
      meta.textContent=`${file.name} · ${(file.size/1024/1024).toFixed(2)} МБ`;meta.className='promo-media-meta small mt-2 text-success';
      const url=URL.createObjectURL(file);preview.innerHTML=file.type==='video/mp4'?`<video src="${url}" controls class="img-fluid rounded" style="max-height:240px"></video>`:`<img src="${url}" class="img-fluid rounded" style="max-height:240px" alt="Предпросмотр">`;
    };
    input.addEventListener('change',()=>render(input.files[0]));
    drop.addEventListener('dragover',event=>{event.preventDefault();drop.classList.add('border-primary')});
    drop.addEventListener('dragleave',()=>drop.classList.remove('border-primary'));
    drop.addEventListener('drop',event=>{event.preventDefault();drop.classList.remove('border-primary');if(event.dataTransfer.files[0]){const transfer=new DataTransfer();transfer.items.add(event.dataTransfer.files[0]);input.files=transfer.files;render(input.files[0]);}});
    drop.querySelector('.promo-clear-file').addEventListener('click',()=>{input.value='';meta.textContent='';preview.innerHTML='';});
  });
  document.querySelectorAll('.promo-action').forEach(button=>button.addEventListener('click',async()=>{
    const action=button.dataset.action;
    if(action==='archive'&&!confirm('Архивировать кампанию? Статистика и медиа сохранятся.'))return;
    if(action==='reset'&&!confirm('Сбросить системную кампанию к настройкам по умолчанию?'))return;
    const response=await fetch(`/admin/api/ad-campaigns/${button.dataset.id}/${action}`,{method:'POST'});const result=await response.json();if(!result.success)return alert(result.error);location.reload();
  }));
  document.querySelectorAll('.promo-delete').forEach(button=>button.addEventListener('click',async()=>{
    const name=button.dataset.name;const confirmation=prompt(`Удалить кампанию «${name}»?\n\nКампания больше не будет доступна в админке. История показов и кликов сохранится.\n\nВведите точное название кампании:`);
    if(confirmation===null)return;
    const response=await fetch(`/admin/api/ad-campaigns/${button.dataset.id}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({confirm_name:confirmation})});const result=await response.json();if(!result.success)return alert(result.error);location.reload();
  }));
};
</script>
