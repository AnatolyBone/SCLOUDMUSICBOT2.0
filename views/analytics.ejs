<script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>

<script>
  async function runSystemSelfTest() {
    const button = document.getElementById('system-self-test-button');
    const resultBox = document.getElementById('system-self-test-result');
    button.disabled = true;
    resultBox.className = 'alert alert-info mb-3';
    resultBox.textContent = 'Выполняется системная проверка...';

    try {
      const response = await fetch('/admin/system/self-test', { method: 'POST' });
      const result = await response.json();
      const names = ['database', 'analytics', 'broadcasts', 'workers', 'excel'];
      const summary = names
        .map(name => `${result[name] === 'ok' ? '✅' : '❌'} ${name}: ${result[name] || 'error'}`)
        .join(' · ');
      resultBox.className = `alert ${result.ok ? 'alert-success' : 'alert-danger'} mb-3`;
      resultBox.textContent = `${summary} (${result.durationMs || 0} ms)`;
    } catch (error) {
      resultBox.className = 'alert alert-danger mb-3';
      resultBox.textContent = `Self-test error: ${error.message}`;
    } finally {
      button.disabled = false;
    }
  }

  let statusInterval = null;
  let wasActive = false;

  // Функция для запроса статуса агрегации
  async function checkAggregationStatus() {
    try {
      const response = await fetch('/admin/analytics/status');
      if (!response.ok) return;
      const state = await response.json();
      
      const dayBtn = document.getElementById('agg-day-btn');
      const periodBtn = document.getElementById('agg-period-btn');
      const backfillBtn = document.getElementById('btn-backfill');
      const progressContainer = document.getElementById('agg-progress-container');
      const generalStatus = document.getElementById('agg-general-status');
      
      if (state.active) {
        wasActive = true;
        // Выключаем кнопки управления
        if (dayBtn) dayBtn.disabled = true;
        if (periodBtn) periodBtn.disabled = true;
        if (backfillBtn) backfillBtn.disabled = true;
        
        // Показываем прогресс-бар
        progressContainer.classList.remove('d-none');
        
        const pct = state.totalDays > 0 ? Math.round((state.currentDayIndex / state.totalDays) * 100) : 0;
        document.getElementById('agg-progress-pct').innerText = pct + '%';
        document.getElementById('agg-progress-bar').style.width = pct + '%';
        document.getElementById('agg-progress-status').innerText = `Выполнено: ${state.currentDayIndex} / ${state.totalDays} дней`;
        document.getElementById('agg-progress-current').innerText = `Текущий день: ${state.currentDay || '—'}`;
        
        generalStatus.innerHTML = '<span class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Выполняется фоновый пересчет данных...</span>';
      } else {
        // Включаем кнопки управления
        if (dayBtn) dayBtn.disabled = false;
        if (periodBtn) periodBtn.disabled = false;
        if (backfillBtn) backfillBtn.disabled = false;
        
        // Прячем прогресс-бар
        progressContainer.classList.add('d-none');
        
        if (state.error) {
          generalStatus.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Ошибка фоновой агрегации: ${state.error}</span>`;
          wasActive = false;
        } else if (wasActive) {
          wasActive = false;
          generalStatus.innerHTML = `
            <div class="alert alert-success d-flex align-items-center justify-content-between mt-2 mb-0 py-2">
              <span>
                <i class="bi bi-check-circle-fill me-2"></i><strong>Агрегация успешно завершена!</strong> 
                Обработано дней: ${state.currentDayIndex} / ${state.totalDays}. Данные в базе обновлены.
              </span>
              <button class="btn btn-sm btn-success text-white py-1" onclick="window.location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i>Обновить графики и данные
              </button>
            </div>
          `;
        }
      }
    } catch (e) {
      console.error('[Status Polling] Error:', e);
    }
  }

  // Запуск фонового опроса
  function startStatusPolling() {
    checkAggregationStatus();
    statusInterval = setInterval(checkAggregationStatus, 2000);
  }

  // Блок 1: Агрегация одного дня
  document.getElementById('agg-day-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('agg-day-btn');
    const status = document.getElementById('agg-general-status');
    const targetDate = document.getElementById('agg-day-date').value;
    
    btn.disabled = true;
    status.innerHTML = '⏳ Выполняется агрегация дня...';
    
    try {
      const response = await fetch('/admin/analytics/aggregate-day', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetDate })
      });
      const data = await response.json();
      if (data.ok) {
        status.innerHTML = `<span class="text-success">✅ Успешно агрегировано за ${data.aggregated}! Обновите страницу.</span>`;
      } else {
        status.innerHTML = `<span class="text-danger">❌ Ошибка: ${data.error}</span>`;
      }
    } catch (err) {
      status.innerHTML = `<span class="text-danger">❌ ${err.message}</span>`;
    }
    btn.disabled = false;
  });

  // Блок 2: Агрегация за период
  document.getElementById('agg-period-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('agg-period-btn');
    const status = document.getElementById('agg-general-status');
    const startDate = document.getElementById('agg-period-start').value;
    const endDate = document.getElementById('agg-period-end').value;
    
    btn.disabled = true;
    status.innerHTML = '⏳ Запуск пересчета периода...';
    
    try {
      const response = await fetch('/admin/analytics/aggregate-period', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ startDate, endDate })
      });
      const data = await response.json();
      if (data.ok) {
        status.innerHTML = `<span class="text-primary">⏳ Фоновая агрегация периода запущена. Прогресс отображается ниже.</span>`;
        checkAggregationStatus();
      } else {
        status.innerHTML = `<span class="text-danger">❌ Ошибка: ${data.error}</span>`;
        btn.disabled = false;
      }
    } catch (err) {
      status.innerHTML = `<span class="text-danger">❌ ${err.message}</span>`;
      btn.disabled = false;
    }
  });

  // Блок 3: Восстановление пропущенных дней
  document.getElementById('btn-backfill')?.addEventListener('click', async function(e) {
    const btn = document.getElementById('btn-backfill');
    const status = document.getElementById('agg-general-status');
    
    btn.disabled = true;
    status.innerHTML = '⏳ Проверка и восстановление пропущенных дней...';
    
    try {
      const response = await fetch('/admin/analytics/backfill', { method: 'POST' });
      const data = await response.json();
      if (data.ok) {
        status.innerHTML = '<span class="text-success">✅ Восстановление дней запущено в фоновом режиме.</span>';
      } else {
        status.innerHTML = `<span class="text-danger">❌ Ошибка: ${data.error}</span>`;
      }
    } catch (err) {
      status.innerHTML = `<span class="text-danger">❌ ${err.message}</span>`;
    }
    btn.disabled = false;
  });

  // ----------------------------------------------------
  // Сравнение периодов (Compare logic)
  // ----------------------------------------------------
  function setPreset(type) {
    const today = new Date();
    
    if (type === '7d') {
      const format = (d) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Moscow' });
      
      const endA = new Date(today);
      const startA = new Date(today); startA.setDate(today.getDate() - 6);
      
      const endB = new Date(today); endB.setDate(today.getDate() - 7);
      const startB = new Date(today); startB.setDate(today.getDate() - 13);
      
      document.getElementById('comp-start-A').value = format(startB);
      document.getElementById('comp-end-A').value = format(endB);
      document.getElementById('comp-start-B').value = format(startA);
      document.getElementById('comp-end-B').value = format(endA);
    } 
    else if (type === '30d') {
      const y = today.getFullYear();
      const m = today.getMonth(); // 0-11
      
      const startOfCurrentMonth = new Date(y, m, 1);
      const endOfCurrentMonth = new Date(y, m + 1, 0);
      
      const startOfLastMonth = new Date(y, m - 1, 1);
      const endOfLastMonth = new Date(y, m, 0);
      
      const format = (d) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Moscow' });
      
      document.getElementById('comp-start-A').value = format(startOfLastMonth);
      document.getElementById('comp-end-A').value = format(endOfLastMonth);
      document.getElementById('comp-start-B').value = format(startOfCurrentMonth);
      document.getElementById('comp-end-B').value = format(endOfCurrentMonth);
    }
  }

  document.getElementById('comparison-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-run-compare');
    const startA = document.getElementById('comp-start-A').value;
    const endA = document.getElementById('comp-end-A').value;
    const startB = document.getElementById('comp-start-B').value;
    const endB = document.getElementById('comp-end-B').value;
    
    btn.disabled = true;
    btn.innerText = 'Загрузка...';

    try {
      const response = await fetch(`/admin/analytics/compare?startA=${startA}&endA=${endA}&startB=${startB}&endB=${endB}`);
      const res = await response.ok ? await response.json() : { ok: false, error: 'Ошибка сервера' };
      
      if (res.ok) {
        document.getElementById('lbl-period-A').innerText = `${startA} — ${endA}`;
        document.getElementById('lbl-period-B').innerText = `${startB} — ${endB}`;
        
        const tbody = document.getElementById('compare-tbody');
        tbody.innerHTML = '';
        
        const metricLabels = {
          registrations: 'Новые регистрации',
          dau: 'Средний DAU',
          wau: 'Средний WAU',
          mau: 'Средний MAU',
          downloads: 'Количество загрузок',
          limits_reached: 'Пользователи, достигшие лимита',
          tariffs_shown: 'Открытия меню тарифов',
          tariffs_clicked: 'Клики по планам оплаты',
          payments_started: 'Создано платежных счетов',
          payments_completed: 'Успешных оплат',
          revenue_rub: 'Выручка в рублях (RUB)',
          revenue_stars: 'Выручка в Telegram Stars (XTR)',
          paying_users: 'Уникальные платящие пользователи',
          conversion: 'Конверсия Free ➔ Paid'
        };
        
        for (const [key, label] of Object.entries(metricLabels)) {
          const m = res.data[key];
          if (!m) continue;
          
          let valA = m.valA;
          let valB = m.valB;
          let diff = m.diff;
          let pct = m.pct;
          
          // Форматирование значений
          if (key === 'revenue_rub') {
            valA = valA.toFixed(2) + ' ₽';
            valB = valB.toFixed(2) + ' ₽';
            diff = (diff >= 0 ? '+' : '') + diff.toFixed(2) + ' ₽';
          } else if (key === 'revenue_stars') {
            valA = '⭐️ ' + valA;
            valB = '⭐️ ' + valB;
            diff = (diff >= 0 ? '+' : '') + diff;
          } else if (key === 'conversion') {
            valA = valA.toFixed(2) + '%';
            valB = valB.toFixed(2) + '%';
            diff = (diff >= 0 ? '+' : '') + diff.toFixed(2) + '%';
          } else {
            diff = (diff >= 0 ? '+' : '') + diff;
          }

          const pctClass = pct >= 0 ? 'badge bg-success' : 'badge bg-danger';
          const pctText = (pct >= 0 ? '+' : '') + pct.toFixed(1) + '%';
          
          tbody.innerHTML += `
            <tr>
              <td class="fw-semibold text-gray-800">${label}</td>
              <td class="text-center font-monospace">${valA}</td>
              <td class="text-center font-monospace">${valB}</td>
              <td class="text-end font-monospace fw-bold ${m.diff >= 0 ? 'text-success' : 'text-danger'}">${diff}</td>
              <td class="text-end font-monospace"><span class="${pctClass}">${pctText}</span></td>
            </tr>
          `;
        }
        
        document.getElementById('compare-results-card').classList.remove('d-none');
      } else {
        alert('Ошибка при расчете сравнения: ' + res.error);
      }
    } catch (err) {
      alert('Ошибка при выполнении запроса: ' + err.message);
    }
    btn.disabled = false;
    btn.innerText = 'Сравнить';
  });

  // ----------------------------------------------------
  // Когортный анализ (Cohorts retention)
  // ----------------------------------------------------
  async function loadCohorts() {
    const tbody = document.getElementById('cohorts-tbody');
    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5"><span class="spinner-border spinner-border-sm text-primary me-2"></span>Построение тепловой карты...</td></tr>';
    
    try {
      const response = await fetch('/admin/analytics/cohorts');
      const res = await response.ok ? await response.json() : { ok: false, error: 'Ошибка сервера' };
      
      if (res.ok) {
        tbody.innerHTML = '';
        
        if (res.data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Недостаточно данных для анализа когорт</td></tr>';
          return;
        }
        
        res.data.forEach(c => {
          const pct = (active, eligible) => eligible > 0 ? Number((active / eligible * 100).toFixed(1)) : null;
          
          const p1 = pct(c.day_1_active, c.day_1_eligible);
          const p7 = pct(c.day_7_active, c.day_7_eligible);
          const p30 = pct(c.day_30_active, c.day_30_eligible);
          const p90 = pct(c.day_90_active, c.day_90_eligible);
          
          const getHeatColorStyle = (val) => {
            if (val === null) return 'background-color: #f8f9fa; color: #adb5bd;';
            if (val === 0) return 'background-color: #f8f9fa; color: #6c757d;';
            if (val < 10) return 'background-color: rgba(13, 110, 253, 0.1); color: #0f3d7a; font-weight: 500;';
            if (val < 20) return 'background-color: rgba(13, 110, 253, 0.3); color: #0d468e; font-weight: 500;';
            if (val < 30) return 'background-color: rgba(13, 110, 253, 0.5); color: #0a2d5c; font-weight: 600;';
            if (val < 50) return 'background-color: rgba(13, 110, 253, 0.7); color: #071f3f; font-weight: 600;';
            return 'background-color: rgba(13, 110, 253, 0.9); color: #ffffff; font-weight: bold;';
          };
          
          tbody.innerHTML += `
            <tr>
              <td class="fw-bold text-gray-800">${c.cohort}</td>
              <td class="fw-bold font-monospace bg-light">${c.size.toLocaleString('ru-RU')}</td>
              <td style="${getHeatColorStyle(p1)}">${p1 === null ? '—' : `${p1}%`}</td>
              <td style="${getHeatColorStyle(p7)}">${p7 === null ? '—' : `${p7}%`}</td>
              <td style="${getHeatColorStyle(p30)}">${p30 === null ? '—' : `${p30}%`}</td>
              <td style="${getHeatColorStyle(p90)}">${p90 === null ? '—' : `${p90}%`}</td>
            </tr>
          `;
        });
      } else {
        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger">Ошибка: ${res.error}</td></tr>`;
      }
    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger">Ошибка сети: ${e.message}</td></tr>`;
    }
  }

  // ----------------------------------------------------
  // Финансовый мониторинг (Revenue Dashboard)
  // ----------------------------------------------------
  function formatRevenueNumber(value, fractionDigits = 2) {
    const number = Number(value);
    const safeNumber = Number.isFinite(number) ? number : 0;
    return safeNumber.toLocaleString('ru-RU', {
      minimumFractionDigits: fractionDigits,
      maximumFractionDigits: fractionDigits
    });
  }

  async function loadRevenueDashboard() {
    const start = '<%= startDate %>';
    const end = '<%= endDate %>';
    
    try {
      const response = await fetch(`/admin/analytics/revenue?startDate=${start}&endDate=${end}`);
      const res = await response.ok ? await response.json() : { ok: false, error: 'Ошибка сервера' };
      
      if (res.ok) {
        const d = res.data;
        
        // Карточки
        document.getElementById('rev-today-val').innerText = formatRevenueNumber(d.today.totalRubEquivalent) + ' ₽';
        document.getElementById('rev-today-sub').innerText = `RUB: ${formatRevenueNumber(d.today.rub)} ₽ | XTR: ⭐️ ${formatRevenueNumber(d.today.stars, 0)} (Заказов: ${formatRevenueNumber(d.today.count, 0)})`;
        
        document.getElementById('rev-mrr-val').innerText = formatRevenueNumber(d.mrr) + ' ₽';
        
        document.getElementById('rev-arppu-val').innerText = formatRevenueNumber(d.arppu) + ' ₽';
        document.getElementById('rev-arppu-sub').innerText = `Платящих за период: ${formatRevenueNumber(d.paying_users, 0)}`;
        
        document.getElementById('rev-conv-val').innerText = formatRevenueNumber(d.conversionFreePaid) + '%';
        document.getElementById('rev-conv-sub').innerText = `Регистраций: ${formatRevenueNumber(d.totalRegistered, 0)}`;
        
        // Таблица
        const tbody = document.getElementById('revenue-breakdown-tbody');
        tbody.innerHTML = '';
        
        if (d.breakdown.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Нет оплат за выбранный период</td></tr>';
          return;
        }
        
        const methodLabels = {
          telegram_stars: '⭐️ Telegram Stars (In-App)',
          telegram_stars_rpc: '⭐️ Telegram Stars (In-App API)',
          tbank: '💳 Т-Банк (Эквайринг)',
          sbp: '📲 СБП (Быстрые платежи)',
          yoomoney: '💸 ЮMoney',
          boosty: '🧡 Boosty (Донаты)',
          other_manual: '👤 Ручной перевод (Админ)'
        };
        
        d.breakdown.forEach(row => {
          const methodLabel = methodLabels[row.method] || `Другой метод (${row.method})`;
          const formattedSum = row.currency === 'RUB'
            ? formatRevenueNumber(row.sum) + ' ₽'
            : '⭐️ ' + formatRevenueNumber(row.sum, 0);
          
          tbody.innerHTML += `
            <tr>
              <td class="fw-semibold text-gray-800">${methodLabel}</td>
              <td class="text-center font-monospace">${row.currency}</td>
              <td class="text-center font-monospace fw-bold text-primary">${formatRevenueNumber(row.count, 0)}</td>
              <td class="text-end font-monospace">${formattedSum}</td>
              <td class="text-end font-monospace fw-bold text-success">${formatRevenueNumber(row.rubEquivalent)} ₽</td>
            </tr>
          `;
        });
      } else {
        console.error('Ошибка финансов:', res.error);
      }
    } catch (e) {
      console.error('Ошибка сети при загрузке финансов:', e.message);
    }
  }

  // Будет вызвано после загрузки Bootstrap и Chart.js
  window.initializePage = function() {
    startStatusPolling();
    
    // Восстанавливаем вкладку
    const activeTab = sessionStorage.getItem('activeAnalyticsTab');
    if (activeTab) {
      const btn = document.getElementById(activeTab);
      if (btn) {
        const tab = new bootstrap.Tab(btn);
        tab.show();
        
        // Вызываем специфичные загрузки
        if (activeTab === 'cohorts-tab') loadCohorts();
        if (activeTab === 'revenue-tab') loadRevenueDashboard();
      }
    } else {
      // По умолчанию
      loadRevenueDashboard(); // подгружаем деньги в фоне
    }

    // Сохраняем выбранную вкладку при клике
    document.querySelectorAll('#analyticsTabs button').forEach(btn => {
      btn.addEventListener('shown.bs.tab', (e) => {
        sessionStorage.setItem('activeAnalyticsTab', e.target.id);
        if (e.target.id === 'cohorts-tab') loadCohorts();
        if (e.target.id === 'revenue-tab') loadRevenueDashboard();
      });
    });

    const rawData = <%- JSON.stringify(dailyRows) %>;
    const labels = rawData.map(r => new Date(r.day).toLocaleDateString('ru-RU', { timeZone: 'UTC' })).reverse();
    const dauData = rawData.map(r => r.dau).reverse();
    const wauData = rawData.map(r => r.wau).reverse();
    const mauData = rawData.map(r => r.mau).reverse();

    // Chart 1: Active Users
    const activeCtx = document.getElementById('activeUsersChart').getContext('2d');
    new Chart(activeCtx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'DAU (Активность за день)',
            data: dauData,
            borderColor: '#4e73df',
            backgroundColor: 'rgba(78, 115, 223, 0.05)',
            tension: 0.3,
            fill: true
          },
          {
            label: 'WAU (За 7 дней)',
            data: wauData,
            borderColor: '#36b9cc',
            borderDash: [5, 5],
            tension: 0.3,
            fill: false
          },
          {
            label: 'MAU (За 30 дней)',
            data: mauData,
            borderColor: '#1cc88a',
            tension: 0.3,
            fill: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top' }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });

    // Chart 2: Funnel
    const funnelCtx = document.getElementById('funnelChart').getContext('2d');
    new Chart(funnelCtx, {
      type: 'bar',
      data: {
        labels: ['Показ предложений', 'Клик по плану', 'Выбор Stars', 'Оплата'],
        datasets: [{
          label: 'Конверсии воронки',
          data: [
            <%= totalShown %>,
            <%= totalClicked %>,
            <%= totalStarted %>,
            <%= totalCompleted %>
          ],
          backgroundColor: [
            'rgba(78, 115, 223, 0.8)',
            'rgba(28, 200, 138, 0.8)',
            'rgba(246, 194, 62, 0.8)',
            'rgba(231, 74, 59, 0.8)'
          ],
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: { beginAtZero: true }
        }
      }
    });
  }

  const paymentLossState = { loaded: false, stage: 'menu', page: 1, totalPages: 1 };
  const paymentLossEscape = value => String(value ?? '').replace(/[&<>'"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));
  const paymentLossPct = value => value == null ? 'н/д' : `${Number(value).toLocaleString('ru-RU', { maximumFractionDigits: 2 })}%`;
  const paymentLossDate = value => value ? new Date(value).toLocaleString('ru-RU', { timeZone: 'Europe/Moscow', dateStyle: 'short', timeStyle: 'short' }) : '—';
  const paymentLossDuration = seconds => {
    if (seconds == null) return 'н/д';
    if (seconds < 60) return `${Math.round(seconds)} сек`;
    if (seconds < 3600) return `${Math.round(seconds / 60)} мин`;
    return `${(seconds / 3600).toLocaleString('ru-RU', { maximumFractionDigits: 1 })} ч`;
  };

  async function loadPaymentLoss(force = false) {
    if (paymentLossState.loaded && !force) return;
    const loading = document.getElementById('payment-loss-loading');
    const content = document.getElementById('payment-loss-content');
    const errorBox = document.getElementById('payment-loss-error');
    loading.classList.remove('d-none'); content.classList.add('d-none'); errorBox.classList.add('d-none');
    const params = new URLSearchParams({
      startDate: '<%= startDate %>', endDate: '<%= endDate %>',
      window: document.getElementById('payment-loss-window').value
    });
    try {
      const response = await fetch(`/admin/analytics/payment-loss?${params}`);
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.error || 'Не удалось загрузить аналитику');
      renderPaymentLoss(data);
      paymentLossState.loaded = true;
      content.classList.remove('d-none');
    } catch (error) {
      errorBox.textContent = error.message; errorBox.classList.remove('d-none');
    } finally { loading.classList.add('d-none'); }
  }

  function renderPaymentLoss(data) {
    document.getElementById('payment-loss-exclusions').textContent = `Исключено служебных ID: ${data.exclusions.count}`;
    const complete = data.dataCompleteness;
    const completeDate = complete.completeFrom ? new Date(`${complete.completeFrom}T00:00:00+03:00`).toLocaleDateString('ru-RU') : 'н/д';
    document.getElementById('payment-loss-completeness').innerHTML = `<strong>Данные полноценно собираются с ${paymentLossEscape(completeDate)}:</strong> ${paymentLossEscape(complete.note)}`;
    const first = data.funnel[0]?.users || 0;
    const dropKeys = { plan:'drop_menu', invoice:'drop_plan', pre_checkout:'drop_invoice', payment:'drop_pre_checkout' };
    document.getElementById('payment-loss-funnel').innerHTML = data.funnel.map((stage, index) => `
      <div class="col-12 col-md-6 col-xl">
        <div class="card shadow-sm border-0 h-100 payment-loss-kpi payment-loss-stage" style="--stage-width:${first ? Math.min(100, stage.users / first * 100) : 0}%">
          <div class="card-body">
            <div class="small text-uppercase fw-bold text-primary mb-2">${paymentLossEscape(stage.label)}</div>
            <button type="button" class="btn btn-link p-0 payment-loss-click payment-loss-count fw-bold text-body" data-payment-loss-stage="${stage.key}">${stage.users.toLocaleString('ru-RU')}</button>
            <button type="button" class="btn btn-link p-0 d-block small text-muted mt-1 payment-loss-click" data-payment-loss-stage="${stage.key}">Событий: ${stage.events.toLocaleString('ru-RU')}</button>
            <div class="small mt-2">От входа: <strong>${paymentLossPct(stage.conversionFromFirst)}</strong></div>
            ${index ? (stage.dropoutUsers == null
              ? '<span class="small text-muted">Потеря: н/д для неполного периода</span>'
              : `<button type="button" class="btn btn-link p-0 small text-danger payment-loss-click" data-payment-loss-stage="${dropKeys[stage.key]}">Потеря: ${stage.dropoutUsers.toLocaleString('ru-RU')} (${paymentLossPct(stage.dropoutPercent)})</button>`)
              : '<span class="small text-muted">Начало воронки</span>'}
          </div>
        </div>
      </div>`).join('');

    const derivedLabels = {
      menuToPlanCtr:'Menu → Plan CTR', planToInvoiceConversion:'Plan → Invoice', invoiceToPreCheckoutConversion:'Invoice → Pre-checkout',
      preCheckoutToPaymentConversion:'Pre-checkout → Payment', menuToPaymentConversion:'Menu → Payment', limitToMenuConversion:'Limit → Menu',
      limitToPaymentConversion:'Limit → Payment', alternativePaymentConversion24h:'Альтернативная оплата (24ч)'
    };
    const derivedDurations = [
      ['Медиана до оплаты', paymentLossDuration(data.derivedMetrics.medianSecondsToPayment)],
      ['Скачиваний до покупки', data.derivedMetrics.avgDownloadsBeforePurchase == null ? 'н/д' : Number(data.derivedMetrics.avgDownloadsBeforePurchase).toLocaleString('ru-RU',{maximumFractionDigits:1})],
      ['Дней от регистрации', data.derivedMetrics.avgDaysRegistrationToPayment == null ? 'н/д' : Number(data.derivedMetrics.avgDaysRegistrationToPayment).toLocaleString('ru-RU',{maximumFractionDigits:1})]
    ];
    document.getElementById('payment-loss-derived').innerHTML = [
      ...Object.entries(derivedLabels).map(([key,label]) => [label,paymentLossPct(data.derivedMetrics[key])]),
      ...derivedDurations
    ].map(([label,value]) => `<div class="col-6 col-lg-3"><div class="card shadow-sm border-0 h-100"><div class="card-body py-3"><div class="small text-muted">${paymentLossEscape(label)}</div><div class="h5 mb-0 mt-1">${paymentLossEscape(value)}</div></div></div></div>`).join('');

    document.getElementById('payment-loss-plans').innerHTML = data.plans.length ? data.plans.map(plan => `<tr>
      <td class="fw-semibold">${paymentLossEscape(plan.plan)}</td><td>${plan.selectedUsers}</td><td>${plan.invoiceUsers}</td><td>${plan.preCheckoutUsers}</td><td>${plan.paymentUsers}</td>
      <td><span class="badge bg-${(plan.conversion || 0) >= 10 ? 'success' : 'warning'}">${paymentLossPct(plan.conversion)}</span></td>
      <td>${paymentLossDuration(plan.avgSecondsToPayment)}</td><td>${plan.avgDownloadsBefore == null ? 'н/д' : Number(plan.avgDownloadsBefore).toLocaleString('ru-RU',{maximumFractionDigits:1})}</td><td>${plan.reachedLimitUsers}</td>
    </tr>`).join('') : '<tr><td colspan="9" class="text-center text-muted py-4">Нет подтверждённых событий выбора тарифа</td></tr>';

    const alt = data.alternative;
    document.getElementById('payment-loss-alternative').innerHTML = `
      <div class="d-flex justify-content-between py-2 border-bottom"><span>Открыли способы</span><strong>${alt.openedUsers}</strong></div>
      <div class="d-flex justify-content-between py-2 border-bottom"><span>Оплатили RUB за 24ч</span><strong class="text-success">${alt.paid24hUsers} · ${paymentLossPct(alt.conversion24h)}</strong></div>
      <div class="d-flex justify-content-between py-2"><span>Оплатили RUB за 7д</span><strong class="text-success">${alt.paid7dUsers} · ${paymentLossPct(alt.conversion7d)}</strong></div>
      <div class="table-responsive mt-3"><table class="table table-sm mb-0"><thead><tr><th>Способ</th><th>Люди / запросы</th><th>RUB 24ч / 7д</th><th>До оплаты</th></tr></thead><tbody>${(alt.methods || []).map(row => `<tr><td>${paymentLossEscape(row.method)}</td><td>${row.openedUsers} / ${row.requestEvents}</td><td>${row.paid24hUsers} / ${row.paid7dUsers}</td><td>${paymentLossDuration(row.avgSecondsToPayment)}</td></tr>`).join('') || '<tr><td colspan="4" class="text-muted">Нет данных</td></tr>'}</tbody></table></div>
      <div class="small text-muted mt-3">Учитываются только completed-платежи; открытие ссылки не считается оплатой.</div>`;

    const behaviorLabels = {
      unpaid_users:'Не оплатили', downloaded_again:'Скачали снова', reached_limit_again:'Снова достигли лимита', reopened_tariffs:'Повторно открыли тарифы',
      changed_plan:'Сменили выбранный план', opened_alternative:'Открыли другой способ', returned_d1:'Вернулись D1', returned_d7:'Вернулись D7',
      no_observed_activity:'Нет наблюдаемой активности', payment_error_users:'Есть запись ошибки платежа'
    };
    document.getElementById('payment-loss-behavior').innerHTML = Object.entries(behaviorLabels).map(([key,label]) => `<div class="col-sm-6"><div class="p-2 rounded bg-light d-flex justify-content-between gap-2"><span class="small">${label}</span><strong>${data.postFunnel[key] || 0}</strong></div></div>`).join('');
    document.getElementById('payment-loss-segments').innerHTML = data.segments.map(row => `<tr><td>${paymentLossEscape(row.segment)}</td><td>${row.users}</td><td>${row.payers}</td><td>${paymentLossPct(row.conversion)}</td></tr>`).join('') || '<tr><td colspan="4" class="text-center text-muted py-4">Нет данных</td></tr>';
    document.getElementById('payment-loss-content-sources').innerHTML = data.contentSources.map(row => `<tr><td>${paymentLossEscape(row.source)}</td><td>${paymentLossEscape(row.entrySource)}</td><td>${row.users}</td><td>${row.successfulDownloads}</td><td>${row.errors ?? 'н/д'}</td><td>${row.reachedLimitUsers}</td><td>${row.selectedUsers}</td><td>${row.invoiceUsers}</td><td>${row.preCheckoutUsers}</td><td>${row.payers}</td><td>${paymentLossPct(row.conversion)}</td><td>${row.returnedD1} / ${row.returnedD7}</td></tr>`).join('') || '<tr><td colspan="12" class="text-center text-muted py-4">Источник не определён</td></tr>';
    document.getElementById('payment-loss-errors').innerHTML = data.paymentErrors.map(row => `<tr><td>${paymentLossEscape(row.category)}</td><td>${row.users}</td><td>${row.events}</td></tr>`).join('') || '<tr><td colspan="3" class="text-center text-muted py-4">Ошибок не зафиксировано</td></tr>';
    const dc = data.downloadContext;
    document.getElementById('payment-loss-download-context').innerHTML = `
      <div class="row g-2">${[
        ['Открыли тарифы после успешного скачивания',dc.menuAfterSuccess],['Открыли тарифы после ошибки',dc.menuAfterError],
        ['Оплатили после успешного скачивания',dc.paidAfterSuccess],['Оплатили после ошибки',dc.paidAfterError],
        ['Успех и ошибка до тарифов',dc.bothSuccessAndError],['Успешных скачиваний',dc.successfulDownloads]
      ].map(([label,value])=>`<div class="col-sm-6"><div class="p-2 rounded bg-light d-flex justify-content-between gap-2"><span class="small">${label}</span><strong>${value}</strong></div></div>`).join('')}</div>
      ${dc.errorTelemetryAvailable ? '' : `<div class="alert alert-warning small mt-3 mb-0">Детальные ошибки скачивания пока не пишутся в analytics_events. Поля ${paymentLossEscape(dc.unavailableFields.join(', '))} показаны как н/д, а не как ложный ноль.</div>`}`;
    const contractRows = data.eventContract || [];
    const observedContract = contractRows.filter(row => row.events > 0).length;
    document.getElementById('payment-loss-contract-summary').textContent = `${observedContract}/${contractRows.length} событий наблюдались`;
    document.getElementById('payment-loss-event-contract').innerHTML = contractRows.map(row => {
      const fields = Object.entries(row.fields).filter(([,present])=>present).map(([name])=>name).join(', ') || '—';
      return `<tr><td><code>${paymentLossEscape(row.eventName)}</code></td><td>${row.events}</td><td>${row.users}</td><td class="small">${paymentLossEscape(fields)}</td></tr>`;
    }).join('');
    document.getElementById('payment-loss-recommendations').innerHTML = data.recommendations.length
      ? data.recommendations.map(rec => `<div class="alert alert-warning mb-2"><strong>${paymentLossEscape(rec.title)}</strong><div class="small mt-1">${paymentLossEscape(rec.text)}</div></div>`).join('')
      : '<div class="text-muted">Рекомендации не формируются: требуется минимум 30 пользователей в начале воронки.</div>';
    document.getElementById('payment-loss-interpretation').innerHTML = data.interpretation.map(item => `<div><i class="bi bi-info-circle me-1"></i>${paymentLossEscape(item)}</div>`).join('');
    document.querySelectorAll('[data-payment-loss-stage]').forEach(button => button.addEventListener('click', () => openPaymentLossUsers(button.dataset.paymentLossStage, 1)));
  }

  async function openPaymentLossUsers(stage, page = 1) {
    paymentLossState.stage = stage; paymentLossState.page = page;
    const params = new URLSearchParams({ startDate:'<%= startDate %>', endDate:'<%= endDate %>', window:document.getElementById('payment-loss-window').value, stage, page, limit:50 });
    const body = document.getElementById('payment-loss-users-body');
    body.innerHTML = '<tr><td colspan="10" class="text-center py-4"><span class="spinner-border spinner-border-sm"></span></td></tr>';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('payment-loss-users-modal')).show();
    try {
      const response = await fetch(`/admin/analytics/payment-loss/users?${params}`); const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.error || 'Ошибка загрузки');
      paymentLossState.totalPages = data.totalPages;
      body.innerHTML = data.users.map(user => `<tr><td><code>${paymentLossEscape(user.user_id)}</code><div>${paymentLossEscape(user.first_name || '—')}</div><div class="small text-muted">${user.username ? '@'+paymentLossEscape(user.username) : 'без username'}</div></td><td>${paymentLossDate(user.registered_at)}<div class="small text-muted">Активен: ${paymentLossDate(user.last_active)}</div></td><td>${paymentLossEscape(user.language_code || '—')}<div class="small text-muted">${paymentLossEscape(user.referral_source || 'unknown')}</div></td><td>${user.downloads_total}<div class="small text-muted">сегодня: ${user.downloads_today}</div></td><td>${user.reached_limit ? '<span class="badge text-bg-warning">Да</span>' : 'Нет'}</td><td>${paymentLossEscape(user.last_tariff_step)}</td><td>${paymentLossEscape(user.plan)}</td><td><div>Меню: ${paymentLossDate(user.menu_at)}</div><div>Выбор: ${paymentLossDate(user.plan_at)}</div><div>Invoice: ${paymentLossDate(user.invoice_at)}</div><div>Pre-checkout: ${paymentLossDate(user.checkout_at)}</div><div class="text-success">Оплата: ${paymentLossDate(user.paid_at)}</div></td><td>${user.payment_errors}</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/user/${encodeURIComponent(user.user_id)}">Профиль</a> <a class="btn btn-sm btn-outline-secondary" href="/admin/user-journey?user_id=${encodeURIComponent(user.user_id)}">Путь</a></td></tr>`).join('') || '<tr><td colspan="10" class="text-center text-muted py-4">Пользователи не найдены</td></tr>';
      document.getElementById('payment-loss-users-page').textContent = `Страница ${data.page} из ${data.totalPages} · всего ${data.total}`;
      document.getElementById('payment-loss-users-prev').disabled = data.page <= 1;
      document.getElementById('payment-loss-users-next').disabled = data.page >= data.totalPages;
    } catch (error) { body.innerHTML = `<tr><td colspan="10" class="text-danger text-center py-4">${paymentLossEscape(error.message)}</td></tr>`; }
  }

  document.getElementById('payment-loss-tab')?.addEventListener('shown.bs.tab', () => loadPaymentLoss());
  document.getElementById('payment-loss-refresh')?.addEventListener('click', () => loadPaymentLoss(true));
  document.getElementById('payment-loss-users-prev')?.addEventListener('click', () => openPaymentLossUsers(paymentLossState.stage, Math.max(1, paymentLossState.page - 1)));
  document.getElementById('payment-loss-users-next')?.addEventListener('click', () => openPaymentLossUsers(paymentLossState.stage, Math.min(paymentLossState.totalPages, paymentLossState.page + 1)));
  window.addEventListener('load', () => {
    if (window.location.hash === '#payment-loss' && window.bootstrap) {
      bootstrap.Tab.getOrCreateInstance(document.getElementById('payment-loss-tab')).show();
    }
  });
</script>
