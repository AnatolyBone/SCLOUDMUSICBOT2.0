<%- contentFor('body') %>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Сквозная аналитика</h1>
    <p class="text-muted mb-0">Показатели воронки, выручки и лимитов (Временная зона: Europe/Moscow)</p>
  </div>
  
  <div class="d-flex gap-2 align-items-end flex-wrap">
    <form class="d-flex gap-2 align-items-end" method="get" action="/admin/analytics">
      <div>
        <label class="form-label small text-muted mb-1">С даты</label>
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= startDate %>">
      </div>
      <div>
        <label class="form-label small text-muted mb-1">По дату</label>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= endDate %>">
      </div>
      <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Показать</button>
    </form>
    
    <a href="/admin/analytics/export?startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn btn-sm btn-success text-white">
      <i class="bi bi-file-earmark-excel me-1"></i>Экспорт XLSX
    </a>
    
    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#aggregation-panel" title="Агрегация данных">
      <i class="bi bi-gear me-1"></i>Агрегация
    </button>
  </div>
</div>

<div class="collapse mb-3" id="aggregation-panel">
  <div class="card card-body bg-light border-0 shadow-sm">
    <div class="row g-3">
      
      <!-- Блок 1: Агрегация одного дня -->
      <div class="col-md-4 border-end">
        <h6 class="fw-semibold text-warning mb-2"><i class="bi bi-calendar-day me-1"></i>Агрегация одного дня</h6>
        <p class="text-muted small mb-2">Пересчитать конкретные сутки при пропусках данных.</p>
        <form id="agg-day-form" class="d-flex gap-2 align-items-end">
          <div class="flex-grow-1">
            <input type="date" id="agg-day-date" class="form-control form-control-sm" required>
          </div>
          <button type="submit" class="btn btn-sm btn-warning" id="agg-day-btn">
            <i class="bi bi-play-fill"></i> Запустить
          </button>
        </form>
      </div>

      <!-- Блок 2: Агрегация за период -->
      <div class="col-md-5 border-end">
        <h6 class="fw-semibold text-primary mb-2"><i class="bi bi-calendar-range me-1"></i>Пересчитать период</h6>
        <p class="text-muted small mb-2">Агрегирует данные последовательно за диапазон дней.</p>
        <form id="agg-period-form" class="d-flex gap-2 align-items-end">
          <div>
            <label class="form-label small text-muted mb-1">С даты</label>
            <input type="date" id="agg-period-start" class="form-control form-control-sm" required>
          </div>
          <div>
            <label class="form-label small text-muted mb-1">По дату</label>
            <input type="date" id="agg-period-end" class="form-control form-control-sm" required>
          </div>
          <button type="submit" class="btn btn-sm btn-primary" id="agg-period-btn">
            <i class="bi bi-play-fill"></i> Запустить
          </button>
        </form>
      </div>

      <!-- Блок 3: Восстановление пропусков -->
      <div class="col-md-3">
        <h6 class="fw-semibold text-success mb-2"><i class="bi bi-tools me-1"></i>Инструменты</h6>
        <p class="text-muted small mb-2">Заполнить дыры за последние 7 дней.</p>
        <button type="button" id="btn-backfill" class="btn btn-sm btn-success w-100">
          <i class="bi bi-arrow-repeat"></i> Восстановить пропущенные
        </button>
      </div>

    </div>

    <!-- Информатор прогресса -->
    <div id="agg-progress-container" class="mt-3 p-3 bg-white rounded border d-none">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="fw-semibold text-primary" id="agg-progress-title">Выполняется агрегация...</span>
        <span class="badge bg-primary" id="agg-progress-pct">0%</span>
      </div>
      <div class="progress mb-2" style="height: 12px;">
        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="agg-progress-bar" role="progressbar" style="width: 0%;"></div>
      </div>
      <div class="d-flex justify-content-between small text-muted">
        <span id="agg-progress-status">Выполнено: 0 / 0 дней</span>
        <span id="agg-progress-current">Текущий день: —</span>
      </div>
    </div>

    <div id="agg-general-status" class="mt-2 small"></div>
  </div>
</div>

<%# Summary Cards %>
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
      <div class="card-body">
        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Средний DAU</div>
        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= avgDau %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
      <div class="card-body">
        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Выручка RUB (СБП/Т-Банк)</div>
        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= (totalRevRub / 100).toFixed(2) %> ₽</div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
      <div class="card-body">
        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Выручка XTR (Stars)</div>
        <div class="h5 mb-0 font-weight-bold text-gray-800">⭐️ <%= totalRevXtr %> Stars</div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
      <div class="card-body">
        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Всего скачиваний</div>
        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalDownloads %></div>
      </div>
    </div>
  </div>
</div>

<%# Charts Section %>
<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white fw-bold"><i class="bi bi-activity me-2 text-primary"></i>Динамика активности (DAU / WAU / MAU)</div>
      <div class="card-body">
        <canvas id="activeUsersChart" height="280"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white fw-bold"><i class="bi bi-funnel-fill me-2 text-warning"></i>Воронка продаж тарифов</div>
      <div class="card-body">
        <canvas id="funnelChart" height="280"></canvas>
      </div>
    </div>
  </div>
</div>

<%# Cohort Limit Analysis %>
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white fw-bold text-primary"><i class="bi bi-bar-chart-steps me-2"></i>Глубокий анализ лимита Free</div>
  <div class="card-body">
    <div class="row g-4">
      <div class="col-md-6 border-end">
        <h5 class="card-title h6 fw-semibold mb-3">Распределение скачиваний пользователей (за период)</h5>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Кол-во треков в день</th>
                <th class="text-end">Пользователей</th>
              </tr>
            </thead>
            <tbody>
              <% if (limitDistribution.length === 0) { %>
                <tr><td colspan="2" class="text-center text-muted">Нет данных</td></tr>
              <% } else { %>
                <% limitDistribution.forEach(row => { %>
                  <tr>
                    <td><%= row.downloads_count %> трек(ов)</td>
                    <td class="text-end fw-bold text-primary"><%= row.users_count %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      
      <div class="col-md-6">
        <h5 class="card-title h6 fw-semibold mb-3">Конверсия и отток после лимита (за период)</h5>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Достигли лимита (Free / Plus / Pro):</span>
            <span class="badge bg-danger rounded-pill"><%= reachedLimit %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Пытались скачать сверх лимита (6-й+ трек):</span>
            <span class="badge bg-warning text-dark rounded-pill"><%= attemptedOverLimit %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Открыли меню тарифов после лимита:</span>
            <span class="badge bg-info rounded-pill"><%= openedOffersAfterLimit %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Оплатили тариф после лимита:</span>
            <span class="badge bg-success rounded-pill"><%= paidAfterLimit %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Вернулись на следующий день после лимита:</span>
            <span class="badge bg-primary rounded-pill"><%= returnedNextDay %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Прекратили активность (Churmed) после лимита:</span>
            <span class="badge bg-secondary rounded-pill"><%= churnedAfterLimit %></span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<%# Historical Data Table %>
<div class="card shadow-sm">
  <div class="card-header bg-white fw-bold"><i class="bi bi-table me-2 text-secondary"></i>Детальная статистика по дням</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-striped align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Дата</th>
            <th class="text-center">DAU</th>
            <th class="text-center">WAU</th>
            <th class="text-center">MAU</th>
            <th class="text-center">Регистрации</th>
            <th class="text-center">Скачиваний</th>
            <th class="text-center">Кэш / Новые</th>
            <th class="text-center">Лимиты</th>
            <th class="text-end">Выручка RUB</th>
            <th class="text-end">Выручка Stars</th>
          </tr>
        </thead>
        <tbody>
          <% if (dailyRows.length === 0) { %>
            <tr><td colspan="10" class="text-center py-4 text-muted">Нет данных для отображения</td></tr>
          <% } else { %>
            <% dailyRows.forEach(row => { %>
              <tr>
                <td class="fw-semibold"><%= new Date(row.day).toLocaleDateString('ru-RU', { timeZone: 'UTC' }) %></td>
                <td class="text-center"><%= row.dau %></td>
                <td class="text-center text-muted"><%= row.wau %></td>
                <td class="text-center text-muted"><%= row.mau %></td>
                <td class="text-center text-success fw-bold">+<%= row.registrations %></td>
                <td class="text-center fw-bold"><%= row.downloads_total %></td>
                <td class="text-center text-muted"><%= row.downloads_from_cache %> / <%= row.downloads_new %></td>
                <td class="text-center text-danger"><%= row.limits_reached %></td>
                <td class="text-end text-success"><%= (row.revenue_rub_minor / 100).toFixed(2) %> ₽</td>
                <td class="text-end text-warning">⭐️ <%= row.revenue_xtr %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>

<script>
  let statusInterval = null;

  // Функция для запроса статуса агрегации
  async function checkAggregationStatus() {
    try {
      const response = await fetch('/admin/analytics/status');
      if (!response.ok) return;
      const state = await response.json();
      
      const dayBtn = document.getElementById('agg-day-btn');
      const periodBtn = document.getElementById('agg-period-btn');
      const backfillBtn = document.getElementById('btn-backfill');
      const progressContainer = document.getElementById('agg-progress-container');
      const generalStatus = document.getElementById('agg-general-status');
      
      if (state.active) {
        // Выключаем кнопки управления
        if (dayBtn) dayBtn.disabled = true;
        if (periodBtn) periodBtn.disabled = true;
        if (backfillBtn) backfillBtn.disabled = true;
        
        // Показываем прогресс-бар
        progressContainer.classList.remove('d-none');
        
        const pct = state.totalDays > 0 ? Math.round((state.currentDayIndex / state.totalDays) * 100) : 0;
        document.getElementById('agg-progress-pct').innerText = pct + '%';
        document.getElementById('agg-progress-bar').style.width = pct + '%';
        document.getElementById('agg-progress-status').innerText = `Выполнено: ${state.currentDayIndex} / ${state.totalDays} дней`;
        document.getElementById('agg-progress-current').innerText = `Текущий день: ${state.currentDay || '—'}`;
        
        generalStatus.innerHTML = '<span class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Выполняется фоновый пересчет данных...</span>';
      } else {
        // Включаем кнопки управления
        if (dayBtn) dayBtn.disabled = false;
        if (periodBtn) periodBtn.disabled = false;
        if (backfillBtn) backfillBtn.disabled = false;
        
        // Прячем прогресс-бар
        progressContainer.classList.add('d-none');
        
        if (state.error) {
          generalStatus.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Ошибка фоновой агрегации: ${state.error}</span>`;
        } else if (generalStatus.innerHTML.includes('выполняется')) {
          generalStatus.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Агрегация успешно завершена!</span>';
        }
      }
    } catch (e) {
      console.error('[Status Polling] Error:', e);
    }
  }

  // Запуск фонового опроса
  function startStatusPolling() {
    checkAggregationStatus();
    statusInterval = setInterval(checkAggregationStatus, 2000);
  }

  // Блок 1: Агрегация одного дня
  document.getElementById('agg-day-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('agg-day-btn');
    const status = document.getElementById('agg-general-status');
    const targetDate = document.getElementById('agg-day-date').value;
    
    btn.disabled = true;
    status.innerHTML = '⏳ Выполняется агрегация дня...';
    
    try {
      const response = await fetch('/admin/analytics/aggregate-day', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetDate })
      });
      const data = await response.json();
      if (data.ok) {
        status.innerHTML = `<span class="text-success">✅ Успешно агрегировано за ${data.aggregated}! Обновите страницу.</span>`;
      } else {
        status.innerHTML = `<span class="text-danger">❌ Ошибка: ${data.error}</span>`;
      }
    } catch (err) {
      status.innerHTML = `<span class="text-danger">❌ ${err.message}</span>`;
    }
    btn.disabled = false;
  });

  // Блок 2: Агрегация за период
  document.getElementById('agg-period-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('agg-period-btn');
    const status = document.getElementById('agg-general-status');
    const startDate = document.getElementById('agg-period-start').value;
    const endDate = document.getElementById('agg-period-end').value;
    
    btn.disabled = true;
    status.innerHTML = '⏳ Запуск пересчета периода...';
    
    try {
      const response = await fetch('/admin/analytics/aggregate-period', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ startDate, endDate })
      });
      const data = await response.json();
      if (data.ok) {
        status.innerHTML = `<span class="text-primary">⏳ Фоновая агрегация периода запущена. Прогресс отображается ниже.</span>`;
        checkAggregationStatus();
      } else {
        status.innerHTML = `<span class="text-danger">❌ Ошибка: ${data.error}</span>`;
        btn.disabled = false;
      }
    } catch (err) {
      status.innerHTML = `<span class="text-danger">❌ ${err.message}</span>`;
      btn.disabled = false;
    }
  });

  // Блок 3: Восстановление пропущенных дней
  document.getElementById('btn-backfill')?.addEventListener('click', async function(e) {
    const btn = document.getElementById('btn-backfill');
    const status = document.getElementById('agg-general-status');
    
    btn.disabled = true;
    status.innerHTML = '⏳ Проверка и восстановление пропущенных дней...';
    
    try {
      const response = await fetch('/admin/analytics/backfill', { method: 'POST' });
      const data = await response.json();
      if (data.ok) {
        status.innerHTML = '<span class="text-success">✅ Восстановление дней запущено в фоновом режиме.</span>';
      } else {
        status.innerHTML = `<span class="text-danger">❌ Ошибка: ${data.error}</span>`;
      }
    } catch (err) {
      status.innerHTML = `<span class="text-danger">❌ ${err.message}</span>`;
    }
    btn.disabled = false;
  });

  // Будет вызвано после загрузки Bootstrap и Chart.js
  window.initializePage = function() {
    startStatusPolling();

    const rawData = <%- JSON.stringify(dailyRows) %>;
    const labels = rawData.map(r => new Date(r.day).toLocaleDateString('ru-RU', { timeZone: 'UTC' })).reverse();
    const dauData = rawData.map(r => r.dau).reverse();
    const wauData = rawData.map(r => r.wau).reverse();
    const mauData = rawData.map(r => r.mau).reverse();

    // Chart 1: Active Users
    const activeCtx = document.getElementById('activeUsersChart').getContext('2d');
    new Chart(activeCtx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'DAU (Активность за день)',
            data: dauData,
            borderColor: '#4e73df',
            backgroundColor: 'rgba(78, 115, 223, 0.05)',
            tension: 0.3,
            fill: true
          },
          {
            label: 'WAU (За 7 дней)',
            data: wauData,
            borderColor: '#36b9cc',
            borderDash: [5, 5],
            tension: 0.3,
            fill: false
          },
          {
            label: 'MAU (За 30 дней)',
            data: mauData,
            borderColor: '#1cc88a',
            tension: 0.3,
            fill: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top' }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });

    // Chart 2: Funnel
    const funnelCtx = document.getElementById('funnelChart').getContext('2d');
    new Chart(funnelCtx, {
      type: 'bar',
      data: {
        labels: ['Показ предложений', 'Клик по плану', 'Выбор Stars', 'Оплата'],
        datasets: [{
          label: 'Конверсии воронки',
          data: [
            <%= totalShown %>,
            <%= totalClicked %>,
            <%= totalStarted %>,
            <%= totalCompleted %>
          ],
          backgroundColor: [
            'rgba(78, 115, 223, 0.8)',
            'rgba(28, 200, 138, 0.8)',
            'rgba(246, 194, 62, 0.8)',
            'rgba(231, 74, 59, 0.8)'
          ],
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: { beginAtZero: true }
        }
      }
    });
  }
</script>
